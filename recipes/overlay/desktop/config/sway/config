# CIBYP 桌面会话 · sway 配置（自研：全浮动、无标题栏、靛蓝强调色、快捷键贴合桌面习惯）
#
# 说明：
#   - 面板/桌面/菜单由自研外壳（cibyp-shell / cibyp-desktop）以 layer-shell 提供，不受本配置影响
#   - 普通应用默认浮动、居中、无标题栏：拖动 = Mod+左键，缩放 = Mod+右键
#   - 无 bar（任务栏由自研面板提供）

set $mod Mod4
set $term foot
set $menu cibypctl menu

xwayland disable
font pango:Noto Sans CJK SC 10
default_border pixel 1
default_floating_border pixel 1
floating_modifier $mod
hide_edge_borders smart
focus_follows_mouse no
mouse_warping output
popup_during_fullscreen smart

# 主题配色（sway 用 #RRGGBB）
#                  border  background  text      indicator  child_border
client.focused          #7C6BFF #1B2439 #E9EEF8 #7C6BFF #7C6BFF
client.focused_inactive #2A3450 #141A2B #93A0BB #2A3450 #2A3450
client.unfocused        #1B2439 #0F1420 #93A0BB #1B2439 #1B2439
client.urgent           #FF6B81 #2A1420 #FFFFFF #FF6B81 #FF6B81
client.placeholder      #1B2439 #0F1420 #93A0BB #1B2439 #1B2439
client.background       #0B0F1A

# 输出：默认分辨率（无头/虚拟输出固定 1280x800；有真实输出时自适应）
output * bg #0B0F1A solid_color
output HEADLESS-1 resolution 1280x800
output HEADLESS-2 resolution 1280x800

# 普通窗口：浮动 + 居中 + 无标题栏 + 合适尺寸
for_window [app_id=".*"] floating enable, border pixel 1, resize set 960 640, move position center
for_window [app_id=".*"] title_format "%title"
for_window [app_id="cibyp-files"] resize set 1000 660
for_window [app_id="cibyp-editor"] resize set 1000 660
for_window [app_id="cibyp-settings"] resize set 880 620
for_window [app_id="cibyp-viewer"] resize set 960 680
for_window [app_id="cibyp-calc"] resize set 320 460, move position center
for_window [app_id="foot"] resize set 900 560


# 自研外壳：优先 layer-shell；若回退为普通窗口，用以下规则钉住位置（app_id 精确匹配优先于上面的通配规则）
for_window [app_id="cibyp-panel"] floating enable, border none, sticky enable, move position 0 0, resize set 1280 38
for_window [app_id="cibyp-desktop"] floating enable, border none, sticky enable, move position 0 0, resize set 1280 800
for_window [app_id="cibyp-menu"] floating enable, border none, move position 0 0, resize set 1280 800
for_window [app_id="cibyp-calendar"] floating enable, border none, move position 0 0, resize set 1280 800
for_window [app_id="cibyp-power"] floating enable, border none, move position 0 0, resize set 1280 800

# 快捷键
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+d exec cibypctl calendar
bindsym $mod+q kill
bindsym $mod+Shift+q exec cibypctl power
bindsym Print exec cibypctl screenshot
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+e exec cibyp-files
bindsym $mod+Shift+e exec cibyp-editor
bindsym $mod+comma exec cibyp-settings
bindsym $mod+Shift+r reload
bindsym $mod+Shift+x exec sudo systemctl poweroff
bindsym $mod+Shift+b exec sudo systemctl reboot

# 工作区
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
workspace $ws1 output HEADLESS-1

# 焦点与移动
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left 60
bindsym $mod+Shift+Right move right 60
bindsym $mod+Shift+Up move up 60
bindsym $mod+Shift+Down move down 60
bindsym $mod+ctrl+Left resize shrink width 80 px or 80 ppt
bindsym $mod+ctrl+Right resize grow width 80 px or 80 ppt
bindsym $mod+ctrl+Up resize shrink height 60 px or 60 ppt
bindsym $mod+ctrl+Down resize grow height 60 px or 60 ppt

# 触控板/指针
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt disabled
}
input type:pointer {
    accel_profile flat
}

# 自动启动（会话脚本也会拉起；这里兜底防止外壳被误关）
exec_always --no-startup-id /usr/local/bin/cibyp-desktop
exec_always --no-startup-id /usr/local/bin/cibyp-shell
