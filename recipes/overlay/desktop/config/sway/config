# Native Wayland Campus desktop. CSD belongs to each application.
set $mod Mod4
set $term cibyp-terminal
xwayland disable
font pango:Noto Sans CJK SC 10
default_border normal 2
default_floating_border normal 2
floating_modifier $mod
focus_follows_mouse no
mouse_warping output
popup_during_fullscreen smart
client.focused #5279d9 #ffffff #293347 #5279d9 #5279d9
client.unfocused #dfe5ef #edf0f6 #738097 #dfe5ef #dfe5ef
client.focused_inactive #dfe5ef #edf0f6 #738097 #dfe5ef #dfe5ef
client.urgent #c76385 #ffffff #293347 #c76385 #c76385
output * bg #e7efff solid_color
output HEADLESS-1 resolution 1280x800
for_window [app_id=".*"] floating enable, move position center
for_window [app_id="com.b5software.cibyp.*"] border none
for_window [app_id="com.b5software.cibyp.calc"] resize set 560 580
for_window [app_id="com.b5software.cibyp.about"] resize set 560 490
# GTK sends modal/dialog size hints; do not force every window to 960x640.
bindsym --release Super_L exec cibypctl menu-key
bindsym $mod+space exec cibypctl menu
bindsym $mod+Return exec $term
bindsym $mod+e exec cibyp-files
bindsym $mod+Shift+e exec cibyp-editor
bindsym $mod+comma exec cibyp-settings
bindsym $mod+d exec cibypctl desktop
bindsym $mod+Up exec cibypctl maximize
bindsym $mod+Down exec cibypctl minimize
bindsym $mod+Left exec cibypctl left
bindsym $mod+Right exec cibypctl right
bindsym Alt+Tab exec cibypctl next
bindsym Alt+Shift+Tab exec cibypctl previous
bindsym Alt+F4 kill
bindsym $mod+q kill
bindsym Print exec cibypctl screenshot
bindsym $mod+Shift+q exec cibypctl power
bindsym $mod+Shift+r reload
bindsym $mod+f fullscreen toggle
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+Left move left 60 px
bindsym $mod+Shift+Right move right 60 px
bindsym $mod+Shift+Up move up 60 px
bindsym $mod+Shift+Down move down 60 px
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}
input type:pointer {
    accel_profile flat
}
