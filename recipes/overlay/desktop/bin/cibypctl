# cibypctl —— 与 CIBYP 桌面外壳通信的小客户端（供 sway 快捷键 / 终端 / Agent 调用）
#   cibypctl menu | calendar | power | screenshot | toast [文本]
# 依赖 $XDG_RUNTIME_DIR/cibyp-shell.sock（由 cibyp-shell 监听）。

import os
import socket
import sys

SOCKET_PATH = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/tmp'), 'cibyp-shell.sock')


def main():
    cmd = ' '.join(sys.argv[1:]).strip()
    if not cmd:
        print('用法: cibypctl menu|calendar|power|screenshot|toast [文本]')
        return 2
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(2)
        s.connect(SOCKET_PATH)
        s.sendall(cmd.encode('utf-8'))
        s.close()
        return 0
    except Exception as e:
        print('无法连接桌面外壳:', e, file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
