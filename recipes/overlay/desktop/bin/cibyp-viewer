# cibyp-viewer —— CIBYP 桌面「图片查看器」（自研，GTK4 + Cairo，无第三方图标/主题资源）
#
# 功能：
#   - 打开图片（png/jpg/jpeg/gif/webp/bmp/svg，Gtk.FileDialog）
#   - 缩放：放大 / 缩小 / 1:1 / 适应窗口；鼠标滚轮缩放
#   - 上一张 / 下一张（同目录图片，按名称排序）
#   - 状态栏显示文件名、像素尺寸与缩放比例
#   - 渲染失败给出中文提示（如 SVG 缺少渲染器时显示可用尺寸）
#
# 依赖：python3-gi + GTK4（其余仅标准库）。

import os
import re
import sys
import xml.etree.ElementTree as ET

# ---- 共享绘制库路径（镜像内 /usr/local 与开发树 ../lib 均可） ----
for _p in ('/usr/local/lib/cibyp-desktop/lib',
           os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib')):
    if _p not in sys.path:
        sys.path.insert(0, _p)

import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')

from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

import cibypui  # noqa: E402

APP_ID = 'com.b5software.cibyp.viewer'
WINDOW_NAME = 'cibyp-viewer'
IMAGE_EXTS = ('.png', '.jpg', '.jpeg', '.gif', '.webp', '.bmp', '.svg')
ZOOM_MIN = 0.05
ZOOM_MAX = 16.0
ZOOM_STEP = 1.15

LOCAL_CSS = b"""
window.cibyp-app { background: rgb(11, 15, 26); }
.cibyp-toolbar { background: rgba(15, 20, 33, 0.90); border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
.cibyp-statusbar { background: rgba(15, 20, 33, 0.90); border-top: 1px solid rgba(255, 255, 255, 0.06); }
.cibyp-canvas { background: rgba(8, 11, 20, 0.92); }
.cibyp-danger { color: rgb(255, 107, 129); }
"""


# ------------------------------------------------------------------ 纯逻辑函数
# 以下函数不依赖 GUI，可用 python3 -c 单独验证。

def is_image(path):
    """判断路径是否为受支持的图片扩展名"""
    return os.path.splitext(path)[1].lower() in IMAGE_EXTS


def list_images(directory):
    """列出目录内所有受支持图片（按名称不区分大小写排序，返回完整路径）"""
    try:
        names = [n for n in os.listdir(directory) if is_image(n)]
    except OSError:
        return []
    names.sort(key=str.casefold)
    return [os.path.join(directory, n) for n in names]


def parse_svg_size(text):
    """从 SVG 文本读取尺寸 → (宽, 高) 或 None（宽高缺失时回退 viewBox）"""
    def _length(value):
        if not value:
            return None
        match = re.match(r'\s*([0-9.]+)', str(value))
        return float(match.group(1)) if match else None

    try:
        root = ET.fromstring(text)
    except ET.ParseError:
        return None
    width = _length(root.get('width'))
    height = _length(root.get('height'))
    if width and height:
        return int(round(width)), int(round(height))
    viewbox = root.get('viewBox') or root.get('viewbox')
    if viewbox:
        parts = re.split(r'[\s,]+', viewbox.strip())
        if len(parts) == 4:
            try:
                return int(round(float(parts[2]))), int(round(float(parts[3])))
            except ValueError:
                return None
    return None


def clamp_zoom(value):
    """缩放系数限制在允许范围内"""
    return max(ZOOM_MIN, min(ZOOM_MAX, float(value)))


# ------------------------------------------------------------------ 小工具

def install_local_css():
    provider = Gtk.CssProvider()
    provider.load_from_data(LOCAL_CSS)
    display = Gdk.Display.get_default()
    if display is not None:
        Gtk.StyleContext.add_provider_for_display(
            display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def make_icon(name, size=18, color=None, stroke=1.9):
    col = color or cibypui.TEXT

    def _draw(_area, cr, w, h, _data):
        cibypui.draw_icon(cr, name, 0, 0, min(w, h), col, stroke)

    area = Gtk.DrawingArea()
    area.set_content_width(size)
    area.set_content_height(size)
    area.set_draw_func(_draw, None)
    return area


def make_minus_icon(size=18, color=None):
    """自绘「减号」图标（cibypui 图标集中没有 minus 分支）"""
    col = color or cibypui.TEXT

    def _draw(_area, cr, w, h, _data):
        cr.set_source_rgba(*cibypui.rgba(col))
        cr.set_line_width(1.9)
        cr.set_line_cap(1)
        cr.move_to(w * 0.18, h / 2)
        cr.line_to(w * 0.82, h / 2)
        cr.stroke()

    area = Gtk.DrawingArea()
    area.set_content_width(size)
    area.set_content_height(size)
    area.set_draw_func(_draw, None)
    return area


def tool_button_icon(child, tip, callback):
    btn = Gtk.Button()
    btn.add_css_class('cibyp-btn')
    btn.set_child(child)
    btn.set_tooltip_text(tip)
    btn.connect('clicked', lambda *_a: callback())
    return btn


def tool_button(name, tip, callback, size=18, color=None):
    return tool_button_icon(make_icon(name, size, color), tip, callback)


def text_button(text, tip, callback, accent=False):
    btn = Gtk.Button(label=text)
    btn.add_css_class('cibyp-btn')
    if accent:
        btn.add_css_class('accent')
    if tip:
        btn.set_tooltip_text(tip)
    btn.connect('clicked', lambda *_a: callback())
    return btn


def label(text, css=None, xalign=0.0):
    lbl = Gtk.Label(label=text, xalign=xalign)
    if css:
        lbl.add_css_class(css)
    return lbl


def pad(widget, margin):
    widget.set_margin_top(margin)
    widget.set_margin_bottom(margin)
    widget.set_margin_start(margin)
    widget.set_margin_end(margin)
    return widget


def show_error(parent, message, detail=''):
    dlg = Gtk.AlertDialog()
    dlg.set_modal(True)
    dlg.set_message(message)
    if detail:
        dlg.set_detail(detail)
    dlg.set_buttons(['知道了'])
    try:
        dlg.show(parent)
    except Exception:
        pass


# ------------------------------------------------------------------ 主窗口

class ViewerWindow(Gtk.ApplicationWindow):

    def __init__(self, app):
        super().__init__(application=app, title='图片查看器')
        self.set_name(WINDOW_NAME)
        self.add_css_class('cibyp-app')
        self.set_default_size(900, 620)

        self.path = None
        self.image_width = 0
        self.image_height = 0
        self.zoom = 1.0
        self.fit_mode = True
        self.siblings = []
        self.index = -1
        self._toast_token = 0

        self._build_header()
        self._build_body()
        self._install_keys()
        self._update_status()

    # --------------------------------------------------------- 界面搭建

    def _build_header(self):
        header = Gtk.HeaderBar()
        header.add_css_class('cibyp-panel')
        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title_box.append(make_icon('viewer', 16))
        self.header_label = label('图片查看器', 'cibyp-title')
        title_box.append(self.header_label)
        header.set_title_widget(title_box)
        self.set_titlebar(header)

    def _build_body(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(root)
        root.append(self._build_toolbar())

        self.picture = Gtk.Picture()
        self.picture.set_can_shrink(True)
        self.picture.set_keep_aspect_ratio(True)

        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.scrolled.add_css_class('cibyp-canvas')
        self.scrolled.set_child(self.picture)
        self.scrolled.set_vexpand(True)

        wheel = Gtk.EventControllerScroll()
        wheel.set_flags(Gtk.EventControllerScrollFlags.VERTICAL)
        wheel.connect('scroll', self._on_scroll)
        self.scrolled.add_controller(wheel)

        self.empty_label = label('（没有打开的图片）\n点击工具栏「打开」或 Ctrl+O 选择图片',
                                 'cibyp-dim', 0.5)
        self.empty_label.set_wrap(True)
        self.empty_label.set_vexpand(True)
        self.empty_label.set_valign(Gtk.Align.CENTER)

        self.stack = Gtk.Stack()
        self.stack.add_named(self.scrolled, 'image')
        self.stack.add_named(self.empty_label, 'empty')
        self.stack.set_visible_child_name('empty')
        root.append(self.stack)
        root.append(self._build_statusbar())

    def _build_toolbar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        bar.add_css_class('cibyp-toolbar')
        bar.append(tool_button('open', '打开图片（Ctrl+O）', self.open_dialog))
        bar.append(tool_button('back', '上一张（←）', lambda: self.step(-1)))
        bar.append(tool_button('forward', '下一张（→）', lambda: self.step(1)))
        spreader = Gtk.Box()
        spreader.set_hexpand(True)
        bar.append(spreader)
        bar.append(tool_button_icon(make_minus_icon(18), '缩小（-）', self.zoom_out))
        bar.append(text_button('1:1', '原始尺寸', self.zoom_reset))
        bar.append(tool_button('plus', '放大（+）', self.zoom_in))
        bar.append(text_button('适应窗口', '按窗口大小自适应', self.zoom_fit, accent=True))
        return pad(bar, 6)

    def _build_statusbar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bar.add_css_class('cibyp-statusbar')
        self.status_label = label('', 'cibyp-dim')
        self.status_label.set_hexpand(True)
        self.status_label.set_ellipsize(3)
        bar.append(self.status_label)
        return pad(bar, 5)

    def _install_keys(self):
        action = Gio.SimpleAction.new('open', None)
        action.connect('activate', lambda *_a: self.open_dialog())
        self.add_action(action)
        app = self.get_application()
        if app is not None:
            app.set_accels_for_action('win.open', ['<Ctrl>o'])

        key = Gtk.EventControllerKey()
        key.connect('key-pressed', self._on_key_pressed)
        self.add_controller(key)

    def _on_key_pressed(self, _controller, keyval, _keycode, _state):
        if keyval in (Gdk.KEY_Left, Gdk.KEY_Up, Gdk.KEY_Page_Up):
            self.step(-1)
            return True
        if keyval in (Gdk.KEY_Right, Gdk.KEY_Down, Gdk.KEY_Page_Down):
            self.step(1)
            return True
        if keyval in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
            self.zoom_in()
            return True
        if keyval in (Gdk.KEY_minus, Gdk.KEY_KP_Subtract):
            self.zoom_out()
            return True
        if keyval in (Gdk.KEY_1, Gdk.KEY_KP_1):
            self.zoom_reset()
            return True
        if keyval == Gdk.KEY_f:
            self.zoom_fit()
            return True
        return False

    # --------------------------------------------------------- 打开与切换

    def open_dialog(self):
        dlg = Gtk.FileDialog()
        dlg.set_title('打开图片')
        filters = Gio.ListStore.new(Gtk.FileFilter)
        images = Gtk.FileFilter()
        images.set_name('图片文件')
        for ext in IMAGE_EXTS:
            images.add_pattern(f'*{ext}')
            images.add_pattern(f'*{ext.upper()}')
        filters.append(images)
        all_filter = Gtk.FileFilter()
        all_filter.set_name('所有文件')
        all_filter.add_pattern('*')
        filters.append(all_filter)
        dlg.set_filters(filters)
        dlg.set_default_filter(images)
        if self.path:
            try:
                dlg.set_initial_folder(Gio.File.new_for_path(os.path.dirname(self.path)))
            except Exception:
                pass

        def _done(source, result, _data):
            try:
                gfile = source.open_finish(result)
            except GLib.Error as exc:
                if not exc.matches(Gio.IOErrorEnum, Gio.IOErrorEnum.CANCELLED):
                    show_error(self, '打开失败', exc.message)
                return
            except Exception as exc:  # noqa: BLE001
                show_error(self, '打开失败', str(exc))
                return
            path = gfile.get_path()
            if path:
                self.load_path(path)

        try:
            dlg.open(self, None, _done, None)
        except Exception as exc:  # noqa: BLE001
            show_error(self, '无法打开文件对话框', str(exc))

    def load_path(self, path):
        """加载图片；失败时保留原图并提示"""
        try:
            with open(path, 'rb') as handle:
                head = handle.read(4096)
        except OSError as exc:
            show_error(self, '打开失败', f'{path}：{exc}')
            return

        texture = None
        width = height = 0
        try:
            texture = Gdk.Texture.new_from_filename(path)
            width = texture.get_width()
            height = texture.get_height()
        except Exception as exc:  # noqa: BLE001
            point = parse_svg_size(head.decode('utf-8', errors='replace')) \
                if path.lower().endswith('.svg') else None
            if point:
                width, height = point
                self._show_placeholder(
                    f'无法渲染该矢量图（缺少 SVG 渲染器）\n{os.path.basename(path)} · {width}×{height}')
            else:
                show_error(self, '无法显示图片', f'{os.path.basename(path)}：{exc}')
                return

        self.path = path
        self.image_width = width
        self.image_height = height
        self.siblings = list_images(os.path.dirname(path))
        try:
            self.index = self.siblings.index(path)
        except ValueError:
            self.index = -1

        if texture is not None:
            self.picture.set_paintable(texture)
            self.empty_label.set_text('（没有打开的图片）\n点击工具栏「打开」或 Ctrl+O 选择图片')
            self.stack.set_visible_child_name('image')
            self.zoom_fit()
        else:
            self._update_status()

        self.header_label.set_text(os.path.basename(path))
        self.set_title(f'{os.path.basename(path)} — 图片查看器')

    def _show_placeholder(self, message):
        self.empty_label.set_text(message)
        self.stack.set_visible_child_name('empty')

    def step(self, delta):
        if not self.siblings or self.index < 0:
            self.toast('当前目录没有其他图片', error=True)
            return
        self.index = (self.index + delta) % len(self.siblings)
        self.load_path(self.siblings[self.index])

    # --------------------------------------------------------- 缩放

    def _set_zoom(self, zoom=None, fit=False):
        if self.image_width <= 0:
            return
        self.fit_mode = bool(fit)
        if fit:
            self.picture.set_can_shrink(True)
            self.picture.set_size_request(-1, -1)
            self.picture.set_hexpand(True)
            self.picture.set_vexpand(True)
            self.picture.set_halign(Gtk.Align.FILL)
            self.picture.set_valign(Gtk.Align.FILL)
        else:
            self.zoom = clamp_zoom(zoom if zoom is not None else self.zoom)
            self.picture.set_can_shrink(False)
            self.picture.set_hexpand(False)
            self.picture.set_vexpand(False)
            self.picture.set_halign(Gtk.Align.CENTER)
            self.picture.set_valign(Gtk.Align.CENTER)
            self.picture.set_size_request(max(1, round(self.image_width * self.zoom)),
                                          max(1, round(self.image_height * self.zoom)))
        self._update_status()

    def zoom_in(self):
        self._set_zoom(self._current_zoom() * ZOOM_STEP)

    def zoom_out(self):
        self._set_zoom(self._current_zoom() / ZOOM_STEP)

    def zoom_reset(self):
        self._set_zoom(1.0)

    def zoom_fit(self):
        self._set_zoom(None, fit=True)

    def _current_zoom(self):
        if not self.fit_mode:
            return self.zoom
        # 适应窗口中滚轮以实际显示比例为基础继续缩放
        width = self.scrolled.get_width()
        height = self.scrolled.get_height()
        if width <= 1 or height <= 1:
            return self.zoom
        try:
            return clamp_zoom(min(width / self.image_width, height / self.image_height))
        except ZeroDivisionError:
            return self.zoom

    def _on_scroll(self, _controller, _dx, dy):
        if self.image_width <= 0:
            return False
        if dy < 0:
            self.zoom_in()
        elif dy > 0:
            self.zoom_out()
        return True

    # --------------------------------------------------------- 状态

    def _update_status(self):
        if not self.path:
            self.status_label.set_text('未打开图片 · 支持 png/jpg/gif/webp/bmp/svg')
            return
        if self.fit_mode:
            zoom_text = '适应窗口'
        else:
            zoom_text = f'{self.zoom * 100:.0f}%'
        index_text = ''
        if self.siblings and self.index >= 0:
            index_text = f' · {self.index + 1}/{len(self.siblings)}'
        self.status_label.set_text(
            f'{os.path.basename(self.path)} · {self.image_width}×{self.image_height}'
            f' · {zoom_text}{index_text}')

    def toast(self, text, error=False):
        self._toast_token += 1
        token = self._toast_token
        self.status_label.set_text(text)
        if error:
            self.status_label.add_css_class('cibyp-danger')
        else:
            self.status_label.remove_css_class('cibyp-danger')

        def _restore():
            if token == self._toast_token:
                self._update_status()
            return False

        GLib.timeout_add(4000, _restore)


# ------------------------------------------------------------------ 应用

class ViewerApp(Gtk.Application):

    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        try:
            cibypui.install_css()
            install_local_css()
            win = ViewerWindow(self)
            initial = cibypui.arg_path()
            if initial and os.path.exists(initial):
                win.load_path(initial)
            win.present()
        except Exception as exc:  # noqa: BLE001
            print(f'cibyp-viewer: 启动失败: {exc}', file=sys.stderr)


def main():
    return ViewerApp().run([sys.argv[0]])


if __name__ == '__main__':
    sys.exit(main())
