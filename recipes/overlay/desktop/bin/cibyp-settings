# cibyp-settings —— CIBYP 桌面「设置」（自研，GTK4 + Cairo，无第三方图标/主题资源）
#
# 功能：
#   - 壁纸样式（3 种变体，预览用 cibypui.paint_wallpaper 自绘）
#   - 主题强调色（3 选 1）
#     → 以上两项仅写入 ~/.config/cibyp/desktop.json，并提示「重启会话生效」
#   - 显示分辨率：wlr-randr --output <名字> --mode <WxH>（无 wlr-randr 时回退 swaymsg 列表）
#   - 系统信息卡片（/etc/os-release、uname -r、lspci 可选，均用 subprocess）
#   - 关于卡片（品牌标记用 cibypui.draw_brandmark）
#
# 依赖：python3-gi + GTK4（其余仅标准库）。

import json
import os
import platform
import re
import subprocess
import sys

# ---- 共享绘制库路径（镜像内 /usr/local 与开发树 ../lib 均可） ----
for _p in ('/usr/local/lib/cibyp-desktop/lib',
           os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib')):
    if _p not in sys.path:
        sys.path.insert(0, _p)

import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')

from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

import cibypui  # noqa: E402

APP_ID = 'com.b5software.cibyp.settings'
WINDOW_NAME = 'cibyp-settings'
CONFIG_PATH = os.path.join(os.path.expanduser('~'), '.config', 'cibyp', 'desktop.json')
WALLPAPERS = (('aurora', '极光'), ('tide', '潮汐'), ('noir', '暗夜'))
ACCENTS = (('indigo', '靛蓝', cibypui.ACCENT),
           ('teal', '青绿', cibypui.ACCENT2),
           ('amber', '琥珀', cibypui.WARN))

LOCAL_CSS = b"""
window.cibyp-app { background: rgb(11, 15, 26); }
.cibyp-statusbar { background: rgba(15, 20, 33, 0.90); border-top: 1px solid rgba(255, 255, 255, 0.06); }
.cibyp-choice {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 12px;
  padding: 6px;
}
.cibyp-choice:hover { background: rgba(255, 255, 255, 0.08); }
.cibyp-choice:checked {
  background: rgba(124, 107, 255, 0.22);
  border-color: rgba(124, 107, 255, 0.65);
}
.cibyp-danger { color: rgb(255, 107, 129); }
.cibyp-ok { color: rgb(77, 214, 193); }
.cibyp-value { color: rgb(233, 238, 248); }
"""


# ------------------------------------------------------------------ 纯逻辑函数
# 以下函数不依赖 GUI，可用 python3 -c 单独验证。

def load_config(path=CONFIG_PATH):
    """读取桌面配置（失败时返回空字典，不影响启动）"""
    try:
        with open(path, 'r', encoding='utf-8') as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except Exception:
        return {}


def save_config(config, path=CONFIG_PATH):
    """原子写入桌面配置"""
    directory = os.path.dirname(path) or '.'
    os.makedirs(directory, exist_ok=True)
    tmp = path + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as handle:
        json.dump(config, handle, ensure_ascii=False, indent=2, sort_keys=True)
        handle.write('\n')
    os.replace(tmp, path)
    return path


def read_os_release(text):
    """/etc/os-release 文本 → 字典"""
    info = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        key, value = line.split('=', 1)
        info[key.strip()] = value.strip().strip('"').strip("'")
    return info


def parse_wlr_randr(text):
    """wlr-randr 输出 → {输出名: {'modes': [WxH...], 'current': WxH|''}}"""
    outputs = {}
    current = None
    for raw in text.splitlines():
        if not raw.strip():
            continue
        if not raw[0].isspace():                      # 顶格行 = 输出名
            name = raw.strip().split()[0].strip('"')
            current = name
            outputs.setdefault(current, {'modes': [], 'current': ''})
            continue
        if current is None:
            continue
        line = raw.strip()
        match = re.match(r'(\d+)x(\d+)\s*px', line)
        if match:
            mode = f'{match.group(1)}x{match.group(2)}'
            if mode not in outputs[current]['modes']:
                outputs[current]['modes'].append(mode)
            if 'current' in line:
                outputs[current]['current'] = mode
    return outputs


def parse_sway_outputs(text):
    """swaymsg -t get_outputs 的 JSON → 与 parse_wlr_randr 相同的结构"""
    outputs = {}
    for entry in json.loads(text):
        name = entry.get('name')
        if not name:
            continue
        modes = []
        for mode in entry.get('modes', []) or []:
            width, height = mode.get('width'), mode.get('height')
            if width and height:
                key = f'{width}x{height}'
                if key not in modes:
                    modes.append(key)
        cur = entry.get('current_mode') or {}
        current_mode = f"{cur.get('width')}x{cur.get('height')}" if cur.get('width') else ''
        if current_mode and current_mode in modes:      # 当前模式排在最前
            modes.remove(current_mode)
            modes.insert(0, current_mode)
        outputs[name] = {'modes': modes, 'current': current_mode}
    return outputs


def run_command(cmd, timeout=6):
    """执行外部命令 → (ok, 输出文本)"""
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        return False, f'未找到命令：{cmd[0]}'
    except subprocess.TimeoutExpired:
        return False, f'命令超时：{" ".join(cmd)}'
    except Exception as exc:  # noqa: BLE001
        return False, str(exc)
    if proc.returncode != 0:
        return False, (proc.stderr or proc.stdout or '命令执行失败').strip()
    return True, proc.stdout


def collect_system_info():
    """系统信息 → [(标签, 值)]，任何一项失败都给出中文说明"""
    rows = [('主机名', platform.node() or '未知')]

    os_name = ''
    try:
        with open('/etc/os-release', 'r', encoding='utf-8') as handle:
            os_name = read_os_release(handle.read()).get('PRETTY_NAME', '')
    except OSError:
        os_name = ''
    rows.append(('系统', os_name or platform.platform()))

    ok, kernel = run_command(['uname', '-r'], timeout=3)
    rows.append(('内核', kernel.strip() if ok else '未知'))

    session = os.environ.get('XDG_CURRENT_DESKTOP') or '未设置'
    if os.environ.get('WAYLAND_DISPLAY'):
        session += f"（Wayland：{os.environ.get('WAYLAND_DISPLAY')}）"
    rows.append(('会话', session))

    try:
        pages = os.sysconf('SC_PHYS_PAGES')
        page_size = os.sysconf('SC_PAGE_SIZE')
        rows.append(('内存', cibypui_human_bytes(pages * page_size)))
    except (ValueError, OSError, AttributeError):
        rows.append(('内存', '未知'))

    if cibypui.which('lspci'):
        ok, text = run_command(['lspci'], timeout=5)
        gpus = [l.split(':', 1)[-1].strip() for l in text.splitlines()
                if ok and re.search(r'(VGA|3D|Display)', l, re.I)]
        rows.append(('图形设备', '；'.join(gpus) if gpus else '未检测到显示设备'))
    else:
        rows.append(('图形设备', '未安装 lspci，已跳过'))

    return rows


def cibypui_human_bytes(n):
    """圆整的容量格式（与 cibyp-files 的 human_size 风格一致）"""
    value = float(n)
    for unit in ('B', 'KiB', 'MiB', 'GiB', 'TiB'):
        if value < 1024.0 or unit == 'TiB':
            return f'{value:.1f} {unit}'
        value /= 1024.0
    return f'{value:.1f} TiB'


# ------------------------------------------------------------------ 小工具

def install_local_css():
    provider = Gtk.CssProvider()
    provider.load_from_data(LOCAL_CSS)
    display = Gdk.Display.get_default()
    if display is not None:
        Gtk.StyleContext.add_provider_for_display(
            display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def make_icon(name, size=18, color=None, stroke=1.9):
    col = color or cibypui.TEXT

    def _draw(_area, cr, w, h, _data):
        cibypui.draw_icon(cr, name, 0, 0, min(w, h), col, stroke)

    area = Gtk.DrawingArea()
    area.set_content_width(size)
    area.set_content_height(size)
    area.set_draw_func(_draw, None)
    return area


def tool_button(name, tip, callback, size=18, color=None):
    btn = Gtk.Button()
    btn.add_css_class('cibyp-btn')
    btn.set_child(make_icon(name, size, color))
    btn.set_tooltip_text(tip)
    btn.connect('clicked', lambda *_a: callback())
    return btn


def label(text, css=None, xalign=0.0):
    lbl = Gtk.Label(label=text, xalign=xalign)
    if css:
        lbl.add_css_class(css)
    return lbl


def pad(widget, margin):
    widget.set_margin_top(margin)
    widget.set_margin_bottom(margin)
    widget.set_margin_start(margin)
    widget.set_margin_end(margin)
    return widget


def make_card(title, icon_name):
    """返回 (卡片容器, 内容区)"""
    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    card.add_css_class('cibyp-card')
    pad(card, 14)
    head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    head.append(make_icon(icon_name, 16))
    head.append(label(title, 'cibyp-title'))
    card.append(head)
    body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    card.append(body)
    return card, body


# ------------------------------------------------------------------ 主窗口

class SettingsWindow(Gtk.ApplicationWindow):

    def __init__(self, app):
        super().__init__(application=app, title='设置')
        self.set_name(WINDOW_NAME)
        self.add_css_class('cibyp-app')
        self.set_default_size(900, 620)

        self.config = load_config()
        self.outputs = {}
        self.output_names = []
        self._toast_token = 0

        self._build_header()
        self._build_body()
        self.reload_outputs()

    # --------------------------------------------------------- 界面搭建

    def _build_header(self):
        header = Gtk.HeaderBar()
        header.add_css_class('cibyp-panel')
        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title_box.append(make_icon('settings', 16))
        title_box.append(label('设置', 'cibyp-title'))
        header.set_title_widget(title_box)
        self.set_titlebar(header)

    def _build_body(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(root)

        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        pad(page, 14)
        page.append(self._card_wallpaper())
        page.append(self._card_accent())
        page.append(self._card_resolution())
        page.append(self._card_system())
        page.append(self._card_about())

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_child(page)
        scroll.set_vexpand(True)
        root.append(scroll)

        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bar.add_css_class('cibyp-statusbar')
        self.status_label = label('配置写入 ~/.config/cibyp/desktop.json · 重启会话生效', 'cibyp-dim')
        self.status_label.set_hexpand(True)
        bar.append(self.status_label)
        root.append(pad(bar, 5))

    def _card_wallpaper(self):
        card, body = make_card('壁纸样式', 'wallpaper')
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        group = None
        current = self.config.get('wallpaper', 'aurora')

        for variant, name in WALLPAPERS:
            button = Gtk.ToggleButton()
            button.add_css_class('cibyp-choice')
            button.set_tooltip_text(f'壁纸：{name}')

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            preview = Gtk.DrawingArea()
            preview.set_content_width(180)
            preview.set_content_height(105)

            def _draw(_area, cr, w, h, _d, _variant=variant):
                try:
                    cibypui.paint_wallpaper(cr, w, h, _variant)
                except Exception:
                    cr.set_source_rgba(*cibypui.rgba(cibypui.SURFACE))
                    cr.paint()

            preview.set_draw_func(_draw, None)
            box.append(preview)
            box.append(label(name, 'cibyp-dim'))
            button.set_child(box)

            if group is None:
                group = button
            else:
                button.set_group(group)
            if variant == current:
                button.set_active(True)
            button.connect('toggled', lambda btn, _v=variant: self.on_wallpaper(btn, _v))
            row.append(button)

        body.append(row)
        body.append(label('在桌面外壳下次启动时生效（本应用不重启会话）', 'cibyp-dim'))
        return card

    def _card_accent(self):
        card, body = make_card('主题强调色', 'grid')
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        group = None
        current = self.config.get('accent', 'indigo')

        for accent_id, name, color in ACCENTS:
            button = Gtk.ToggleButton()
            button.add_css_class('cibyp-choice')

            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            swatch = Gtk.DrawingArea()
            swatch.set_content_width(26)
            swatch.set_content_height(26)

            def _draw(_area, cr, w, h, _d, _color=color):
                cr.set_source_rgba(*cibypui.rgba(_color))
                cibypui._round_rect(cr, 2, 2, w - 4, h - 4, 8)
                cr.fill()
                cr.set_source_rgba(1, 1, 1, 0.75)
                cr.set_line_width(1.6)
                cr.arc(w / 2, h / 2, max(w, h) / 2 - 5, 0, 6.2832)
                cr.stroke()

            swatch.set_draw_func(_draw, None)
            box.append(swatch)
            box.append(label(name))
            button.set_child(box)

            if group is None:
                group = button
            else:
                button.set_group(group)
            if accent_id == current:
                button.set_active(True)
            button.connect('toggled', lambda btn, _a=accent_id: self.on_accent(btn, _a))
            row.append(button)

        body.append(row)
        return card

    def _card_resolution(self):
        card, body = make_card('显示分辨率', 'desktop')

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.append(label('输出', 'cibyp-dim'))
        self.output_dd = Gtk.DropDown.new_from_strings(['（未检测到输出）'])
        self.output_dd.set_sensitive(False)
        self.output_dd.connect('notify::selected', lambda *_a: self._on_output_changed())
        row.append(self.output_dd)

        row.append(label('模式', 'cibyp-dim'))
        self.mode_dd = Gtk.DropDown.new_from_strings(['—'])
        self.mode_dd.set_sensitive(False)
        row.append(self.mode_dd)

        apply_btn = Gtk.Button(label='应用')
        apply_btn.add_css_class('cibyp-btn')
        apply_btn.add_css_class('accent')
        apply_btn.connect('clicked', lambda *_a: self.apply_resolution())
        row.append(apply_btn)
        row.append(tool_button('refresh', '重新检测输出', self.reload_outputs))
        body.append(row)

        self.res_label = label('正在检测输出设备…', 'cibyp-dim')
        self.res_label.set_wrap(True)
        body.append(self.res_label)
        body.append(label('通过 wlr-randr --output <名字> --mode <宽x高> 设置，失败时在下方显示错误。', 'cibyp-dim'))
        return card

    def _card_system(self):
        card, body = make_card('系统信息', 'info')
        self.sys_grid = Gtk.Grid()
        self.sys_grid.set_row_spacing(6)
        self.sys_grid.set_column_spacing(16)
        body.append(self.sys_grid)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.append(tool_button('refresh', '刷新系统信息', self.refresh_system))
        row.append(label('数据来自 /etc/os-release、uname -r、lspci', 'cibyp-dim'))
        body.append(row)
        self.refresh_system()
        return card

    def _card_about(self):
        card, body = make_card('关于', 'info')
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)

        mark = Gtk.DrawingArea()
        mark.set_content_width(64)
        mark.set_content_height(64)

        def _draw(_area, cr, _w, _h, _d):
            cibypui.draw_brandmark(cr, 0, 0, 64)

        mark.set_draw_func(_draw, None)
        row.append(mark)

        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        info.append(label('CIBYP-VM-OS', 'cibyp-title'))
        info.append(label(f'版本：{self.cibyp_version()}', 'cibyp-dim'))
        info.append(label('许可证：GPL-3.0-or-later', 'cibyp-dim'))
        info.append(label('桌面组件：Python 3 + GTK4 + Cairo（自研，无第三方主题/图标资源）', 'cibyp-dim'))
        row.append(info)
        body.append(row)
        return card

    def cibyp_version(self):
        for path in ('/etc/cibyp-release', '/etc/cibyp-version'):
            try:
                with open(path, 'r', encoding='utf-8') as handle:
                    text = handle.read().strip()
                if text:
                    return text.splitlines()[0]
            except OSError:
                continue
        return '开发版'

    # --------------------------------------------------------- 壁纸 / 强调色

    def on_wallpaper(self, button, variant):
        if not button.get_active():
            return
        self.config['wallpaper'] = variant
        self.save_and_hint('壁纸样式')

    def on_accent(self, button, accent_id):
        if not button.get_active():
            return
        self.config['accent'] = accent_id
        self.save_and_hint('主题强调色')

    def save_and_hint(self, what):
        try:
            path = save_config(self.config)
        except Exception as exc:  # noqa: BLE001
            self.toast(f'保存失败：{exc}', error=True)
            return
        if what == '壁纸样式':
            name = dict(WALLPAPERS).get(self.config.get('wallpaper', ''), '')
        else:
            name = {item[0]: item[1] for item in ACCENTS}.get(self.config.get('accent', ''), '')
        self.toast(f'{what}「{name}」已保存到 {path} · 重启会话生效')

    # --------------------------------------------------------- 分辨率

    def reload_outputs(self):
        outputs = {}
        messages = []

        if cibypui.which('wlr-randr'):
            ok, text = run_command(['wlr-randr'], timeout=6)
            if ok:
                outputs = parse_wlr_randr(text)
            else:
                messages.append(f'wlr-randr 执行失败：{text}')
        else:
            messages.append('未检测到 wlr-randr')

        if not outputs and cibypui.which('swaymsg'):
            ok, text = run_command(['swaymsg', '-t', 'get_outputs'], timeout=6)
            if ok:
                try:
                    outputs = parse_sway_outputs(text)
                except Exception as exc:  # noqa: BLE001
                    messages.append(f'swaymsg 输出解析失败：{exc}')
            else:
                messages.append(f'swaymsg 执行失败：{text}')

        self.outputs = outputs
        self.output_names = sorted(outputs.keys())
        if not self.output_names:
            self.output_dd.set_model(Gtk.StringList.new(['（未检测到输出）']))
            self.output_dd.set_sensitive(False)
            self.mode_dd.set_model(Gtk.StringList.new(['—']))
            self.mode_dd.set_sensitive(False)
            self._set_res_text('未检测到可用输出。' + '；'.join(messages), error=True)
            return

        self.output_dd.set_model(Gtk.StringList.new(self.output_names))
        self.output_dd.set_sensitive(True)
        self.output_dd.set_selected(0)
        self._on_output_changed()
        info = '；'.join(messages)
        self._set_res_text(f'已检测到 {len(self.output_names)} 个输出设备。' + (f'（{info}）' if info else ''))

    def _on_output_changed(self, *_a):
        index = self.output_dd.get_selected()
        if index < 0 or index >= len(self.output_names):
            self.mode_dd.set_model(Gtk.StringList.new(['—']))
            self.mode_dd.set_sensitive(False)
            return
        name = self.output_names[index]
        info = self.outputs.get(name, {})
        modes = info.get('modes') or []
        current = info.get('current') or ''
        if not modes:
            self.mode_dd.set_model(Gtk.StringList.new(['（该输出没有可用模式）']))
            self.mode_dd.set_sensitive(False)
            return
        self.mode_dd.set_model(Gtk.StringList.new(modes))
        self.mode_dd.set_sensitive(True)
        if current in modes:
            self.mode_dd.set_selected(modes.index(current))
        else:
            self.mode_dd.set_selected(0)

    def apply_resolution(self):
        index = self.output_dd.get_selected()
        if index < 0 or index >= len(self.output_names):
            self._set_res_text('请先选择输出设备', error=True)
            return
        output = self.output_names[index]
        mode_item = self.mode_dd.get_selected_item()
        if mode_item is None or not self.mode_dd.get_sensitive():
            self._set_res_text('该输出没有可用模式', error=True)
            return
        mode = mode_item.get_string()

        exe = cibypui.which('wlr-randr')
        if not exe:
            self._set_res_text('未找到 wlr-randr，无法设置分辨率', error=True)
            return
        cmd = [exe, '--output', output, '--mode', mode]
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        except Exception as exc:  # noqa: BLE001
            self._set_res_text(f'执行失败：{exc}', error=True)
            return
        if proc.returncode != 0:
            detail = (proc.stderr or proc.stdout or '未知错误').strip()
            self._set_res_text(f'设置失败：{detail}', error=True)
            return
        self._set_res_text(f'已应用：{" ".join(cmd)}', ok=True)
        GLib.timeout_add(1500, self.reload_outputs_safe)

    def reload_outputs_safe(self):
        try:
            self.reload_outputs()
        except Exception:  # noqa: BLE001
            pass
        return False

    def _set_res_text(self, text, error=False, ok=False):
        self.res_label.set_text(text)
        for cls in ('cibyp-danger', 'cibyp-ok'):
            self.res_label.remove_css_class(cls)
        if error:
            self.res_label.add_css_class('cibyp-danger')
        elif ok:
            self.res_label.add_css_class('cibyp-ok')

    # --------------------------------------------------------- 系统信息

    def refresh_system(self):
        while self.sys_grid.get_first_child() is not None:
            self.sys_grid.remove(self.sys_grid.get_first_child())
        try:
            rows = collect_system_info()
        except Exception as exc:  # noqa: BLE001
            rows = [('读取失败', str(exc))]
        for i, (key, value) in enumerate(rows):
            key_label = label(key, 'cibyp-dim')
            key_label.set_valign(Gtk.Align.START)
            value_label = label(value, 'cibyp-value')
            value_label.set_selectable(True)
            value_label.set_wrap(True)
            value_label.set_max_width_chars(72)
            self.sys_grid.attach(key_label, 0, i, 1, 1)
            self.sys_grid.attach(value_label, 1, i, 1, 1)

    # --------------------------------------------------------- 提示

    def toast(self, text, error=False):
        self._toast_token += 1
        token = self._toast_token
        self.status_label.set_text(text)
        self.status_label.remove_css_class('cibyp-danger')
        if error:
            self.status_label.add_css_class('cibyp-danger')

        def _restore():
            if token == self._toast_token:
                self.status_label.set_text('配置写入 ~/.config/cibyp/desktop.json · 重启会话生效')
                self.status_label.remove_css_class('cibyp-danger')
            return False

        GLib.timeout_add(6000, _restore)


# ------------------------------------------------------------------ 应用

class SettingsApp(Gtk.Application):

    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        try:
            cibypui.install_css()
            install_local_css()
            win = SettingsWindow(self)
            win.present()
        except Exception as exc:  # noqa: BLE001
            print(f'cibyp-settings: 启动失败: {exc}', file=sys.stderr)


def main():
    return SettingsApp().run([sys.argv[0]])


if __name__ == '__main__':
    sys.exit(main())
