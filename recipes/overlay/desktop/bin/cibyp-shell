# CIBYP 桌面外壳（自研）：面板 + 任务栏 + 开始菜单 + 日历 + 电源/截图 + 桌面右键。
#
# 结构（Wayland layer-shell）：
#   TOP      面板（通栏 38px，独占区 38）
#   OVERLAY  开始菜单 / 日历 / 电源 / 提示条（全屏透明层，菜单卡片自绘）
#   （桌面壁纸与桌面右键由 cibyp-desktop 负责，BACKGROUND 层）
#
# 与 Compositor 的集成：sway IPC（swaymsg -t get_tree，轮询）+ $SWAYSOCK 存在性检测；
# 无 sway 时任务栏自动隐藏（便于单元/无窗口环境运行）。
# 外部命令通道：$XDG_RUNTIME_DIR/cibyp-shell.sock（cibypctl menu|screenshot|power|reload）。

import json
import os
import shlex
import socket
import subprocess
import sys
import time
from datetime import datetime

for _p in ('/usr/local/lib/cibyp-desktop/lib', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib')):
    if _p not in sys.path:
        sys.path.insert(0, _p)

import gi  # noqa: E402

gi.require_version('Gdk', '4.0')
gi.require_version('Gtk', '4.0')
gi.require_version('Gtk4LayerShell', '1.0')
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

import cibypui as ui  # noqa: E402

def single_instance_guard(name):
    """单实例锁：同一用户下重复拉起直接退出（避免双面板/双桌面层）。"""
    import fcntl
    rt = os.environ.get('XDG_RUNTIME_DIR', '/tmp')
    try:
        os.makedirs(rt, exist_ok=True)
        lock_path = os.path.join(rt, 'cibyp-' + name + '.lock')
        fh = open(lock_path, 'w')
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fh.write(str(os.getpid()))
        fh.flush()
        globals()['_instance_lock_fh'] = fh   # 持有引用，进程存活期间不释放
        return True
    except Exception:
        return False


CONFIG_DIR = os.path.expanduser('~/.config/cibyp')
CONFIG_FILE = os.path.join(CONFIG_DIR, 'desktop.json')
SOCKET_PATH = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/tmp'), 'cibyp-shell.sock')


# ------------------------------------------------------------------ 配置

def load_config():
    try:
        with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return {}


def save_config(cfg):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, 'w', encoding='utf-8') as f:
            json.dump(cfg, f, ensure_ascii=False, indent=2)
    except Exception:
        pass


# ------------------------------------------------------------------ 应用扫描

def scan_apps():
    """扫描 .desktop（自研解析，零依赖），返回 [{id,name,exec,icon}]"""
    out = []
    seen = set()
    for d in ('/usr/share/applications', '/usr/local/share/applications',
              os.path.expanduser('~/.local/share/applications')):
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith('.desktop'):
                continue
            aid = fn[:-8]
            if aid in seen:
                continue
            try:
                with open(os.path.join(d, fn), 'r', encoding='utf-8', errors='ignore') as f:
                    name = name_zh = exec_line = icon = ''
                    nodisplay = False
                    for line in f:
                        line = line.strip()
                        if line.startswith('Name[zh_CN]='):
                            name_zh = line.split('=', 1)[1]
                        elif line.startswith('Name='):
                            name = line.split('=', 1)[1]
                        elif line.startswith('Exec='):
                            exec_line = line.split('=', 1)[1]
                        elif line.startswith('Icon='):
                            icon = line.split('=', 1)[1]
                        elif line.startswith('NoDisplay=true'):
                            nodisplay = True
                if nodisplay or not exec_line:
                    continue
                seen.add(aid)
                out.append({'id': aid, 'name': name_zh or name or aid, 'exec': exec_line, 'icon': icon})
            except Exception:
                continue
    out.sort(key=lambda a: a['name'].lower())
    return out


def desktop_icon(app):
    return ui.app_icon_name(f"{app.get('id', '')} {app.get('name', '')} {app.get('icon', '')}")


def launch_desktop(app):
    cmd = app.get('exec', '')
    for token in ('%U', '%u', '%F', '%f', '%i', '%c', '%k'):
        cmd = cmd.replace(token, ' ')
    try:
        ui.launch(shlex.split(cmd.strip()))
    except Exception:
        pass


# ------------------------------------------------------------------ sway IPC

def sway_tree():
    try:
        out = subprocess.run(['swaymsg', '-t', 'get_tree'], capture_output=True, timeout=1.2)
        if out.returncode != 0:
            return None
        return json.loads(out.stdout.decode('utf-8', 'ignore'))
    except Exception:
        return None


def sway_cmd(cmd):
    try:
        subprocess.Popen(['swaymsg', cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def collect_windows(node, acc):
    """收集可显示窗口（app_id/title/visible/focused）"""
    if not isinstance(node, dict):
        return
    if node.get('type') == 'con' and node.get('pid'):
        app_id = (node.get('app_id') or node.get('window_properties', {}).get('class') or '')
        title = node.get('name') or ''
        if app_id == 'cibyp-panel' or app_id == 'cibyp-desktop':
            pass
        elif title and not node.get('scratchpad_state') == 'fresh':
            acc.append({
                'id': node.get('id'),
                'app_id': app_id,
                'title': title,
                'focused': bool(node.get('focused')),
                'visible': bool(node.get('visible')),
            })
    for key in ('nodes', 'floating_nodes'):
        for child in node.get(key) or []:
            collect_windows(child, acc)


# ------------------------------------------------------------------ 自绘控件

class IconButton(Gtk.DrawingArea):
    """自绘图标按钮（悬停/按下/选中态）"""

    def __init__(self, icon, size=20, tooltip=None, on_click=None, color=None):
        super().__init__()
        self.icon = icon
        self.size = size
        self.color = color
        self._hover = False
        self._active = False
        self._selected = False
        self.set_content_width(size + 16)
        self.set_content_height(size + 10)
        self.set_draw_func(self._draw)
        if tooltip:
            self.set_tooltip_text(tooltip)
        if on_click:
            click = Gtk.GestureClick()
            click.connect('released', lambda *_: on_click())
            self.add_controller(click)
            motion = Gtk.EventControllerMotion()
            motion.connect('enter', lambda *_: (setattr(self, '_hover', True), self.queue_draw()))
            motion.connect('leave', lambda *_: (setattr(self, '_hover', False), self.queue_draw()))
            self.add_controller(motion)

    def set_selected(self, v):
        self._selected = bool(v)
        self.queue_draw()

    def set_color(self, c):
        self.color = c
        self.queue_draw()

    def _draw(self, _area, cr, w, h):
        if self._hover or self._selected:
            cr.set_source_rgba(1, 1, 1, 0.14 if self._selected else 0.08)
            ui._round_rect(cr, 2, 2, w - 4, h - 4, 8)
            cr.fill()
        if self._selected:
            cr.set_source_rgba(*ui.rgba(ui.ACCENT, 0.95))
            ui._round_rect(cr, 3, h - 5, w - 6, 3, 1.5)
            cr.fill()
        ui.draw_icon(cr, self.icon, (w - self.size) / 2, (h - self.size) / 2, self.size, self.color or ui.TEXT)


class TaskButton(Gtk.Box):
    """任务栏窗口按钮：图标 + 标题 + 关闭"""

    def __init__(self, win, on_focus, on_close):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.win = win
        self.set_valign(Gtk.Align.CENTER)
        self.add_css_class('cibyp-btn')
        self.set_tooltip_text(win['title'])
        icon = Gtk.DrawingArea()
        icon.set_content_width(18)
        icon.set_content_height(18)
        _icon_name = ui.app_icon_name(f"{win['app_id']} {win['title']}")
        icon.set_draw_func(lambda _a, cr, w, h: ui.draw_icon(cr, _icon_name, 0, 0, min(w, h),
                                                              ui.ACCENT2 if win['focused'] else ui.TEXT_DIM))
        label = Gtk.Label(label=win['title'][:22] + ('…' if len(win['title']) > 22 else ''))
        label.set_ellipsize(Pango.EllipsizeMode.END)
        label.set_max_width_chars(18)
        if win['focused']:
            label.add_css_class('cibyp-title')
        else:
            label.add_css_class('cibyp-dim')
        self.append(icon)
        self.append(label)

        click = Gtk.GestureClick()
        click.connect('released', lambda g, n, x, y: on_focus(self.win))
        self.add_controller(click)
        close = IconButton('close', size=12, tooltip='关闭窗口', on_click=lambda: on_close(self.win))
        close.add_css_class('cibyp-dim')
        self.append(close)


# ------------------------------------------------------------------ 面板

class Panel(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app)
        self.set_name('cibyp-panel')
        self.set_decorated(False)
        self.add_css_class('cibyp-panel')
        LayerShell.init_for_window(self)
        LayerShell.set_layer(self, LayerShell.Layer.TOP)
        LayerShell.set_namespace(self, 'cibyp-panel')
        LayerShell.set_anchor(self, LayerShell.Edge.TOP, True)
        LayerShell.set_anchor(self, LayerShell.Edge.LEFT, True)
        LayerShell.set_anchor(self, LayerShell.Edge.RIGHT, True)
        LayerShell.set_exclusive_zone(self, ui.panel_height())

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        box.set_margin_start(6)
        box.set_margin_end(6)
        self.set_child(box)

        # 左：品牌 + 开始
        brand = IconButton('menu', size=20, tooltip='开始菜单（Super）', on_click=self.toggle_menu, color=ui.ACCENT2)
        box.append(brand)
        self.menu_btn = brand

        self.tasks = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        self.tasks.set_hexpand(True)
        self.tasks.set_halign(Gtk.Align.START)
        box.append(self.tasks)

        # 右：快捷动作 + 状态
        self.clock = Gtk.Button(label='--:--')
        self.clock.add_css_class('cibyp-btn')
        self.clock.connect('clicked', lambda *_: app.toggle_calendar())
        box.append(self.clock)

        for icon, tip, cb in (
            ('terminal', '终端', lambda: ui.launch(['foot'])),
            ('files', '文件', lambda: ui.launch(['cibyp-files'])),
            ('wallpaper', '截图', app.take_screenshot),
            ('power', '电源', app.toggle_power),
        ):
            box.append(IconButton(icon, size=18, tooltip=tip, on_click=cb))

        # 时钟/任务栏刷新
        GLib.timeout_add(1000, self._tick_clock)
        GLib.timeout_add(1200, self._tick_tasks)
        self._windows_sig = ''
        self._tick_clock()
        self._tick_tasks()

    def _tick_clock(self):
        now = datetime.now()
        self.clock.set_label(now.strftime('%m-%d %H:%M'))
        return True

    def _tick_tasks(self):
        try:
            return self._tick_tasks_inner()
        except Exception as exc:  # noqa: BLE001 —— 定时器不能因一次异常停摆
            if not getattr(self, '_task_err_logged', False):
                self._task_err_logged = True
                print('cibyp-shell: 任务栏刷新异常:', exc, file=sys.stderr)
            return True

    def _tick_tasks_inner(self):
        app = self.get_application()
        if os.environ.get('SWAYSOCK'):
            tree = sway_tree()
            wins = []
            if tree:
                collect_windows(tree, wins)
            sig = json.dumps([(w['id'], w['title'], w['focused']) for w in wins], ensure_ascii=False)
            if sig != self._windows_sig:
                self._windows_sig = sig
                while (child := self.tasks.get_first_child()) is not None:
                    self.tasks.remove(child)
                for w in wins:
                    self.tasks.append(TaskButton(
                        w,
                        on_focus=lambda win: sway_cmd(f'[con_id={win["id"]}] focus'),
                        on_close=lambda win: sway_cmd(f'[con_id={win["id"]}] kill'),
                    ))
        return True

    def toggle_menu(self):
        self.get_application().toggle_menu()


# ------------------------------------------------------------------ 开始菜单

class StartMenu(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app)
        self.set_name('cibyp-menu')
        self.set_decorated(False)
        LayerShell.init_for_window(self)
        LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
        LayerShell.set_namespace(self, 'cibyp-menu')
        for e in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(self, e, True)
        LayerShell.set_exclusive_zone(self, -1)
        LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.EXCLUSIVE)

        self.apps = scan_apps()
        root = Gtk.Box()
        root.set_hexpand(True)
        root.set_vexpand(True)
        self.set_child(root)

        click = Gtk.GestureClick()
        click.connect('released', self._on_bg_click)
        root.add_controller(click)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.add_css_class('cibyp-card')
        card.set_size_request(420, 520)
        card.set_halign(Gtk.Align.START)
        card.set_valign(Gtk.Align.END)
        card.set_margin_start(12)
        card.set_margin_bottom(12)
        root.append(card)
        stop = Gtk.GestureClick()
        stop.connect('released', lambda *_: None)
        card.add_controller(stop)

        # 顶部：品牌 + 搜索
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        head.set_margin_top(14)
        head.set_margin_start(16)
        head.set_margin_end(16)
        mark = Gtk.DrawingArea()
        mark.set_content_width(30)
        mark.set_content_height(30)
        mark.set_draw_func(lambda _a, cr, w, h: ui.draw_brandmark(cr, 0, 0, min(w, h)))
        head.append(mark)
        title = Gtk.Label(label='CIBYP 桌面')
        title.add_css_class('cibyp-title')
        head.append(title)
        card.append(head)

        self.search = Gtk.SearchEntry(placeholder_text='搜索应用…')
        self.search.add_css_class('cibyp-entry')
        self.search.set_margin_start(16)
        self.search.set_margin_end(16)
        self.search.connect('search-changed', lambda *_: self._fill())
        self.search.connect('activate', lambda *_: self._open_first())
        card.append(self.search)

        self.grid = Gtk.FlowBox()
        self.grid.set_valign(Gtk.Align.START)
        self.grid.set_selection_mode(Gtk.SelectionMode.NONE)
        self.grid.set_max_children_per_line(4)
        self.grid.set_min_children_per_line(4)
        self.grid.set_row_spacing(6)
        self.grid.set_column_spacing(6)
        self.grid.set_margin_start(12)
        self.grid.set_margin_end(12)
        self.grid.set_margin_bottom(10)
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.set_child(self.grid)
        card.append(scroll)

        # 底部：工作区快捷 + 电源
        foot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        foot.set_margin_start(14)
        foot.set_margin_end(14)
        foot.set_margin_bottom(12)
        for icon, tip, cb in (
            ('terminal', '终端', lambda: ui.launch(['foot'])),
            ('files', '文件', lambda: ui.launch(['cibyp-files'])),
            ('settings', '设置', lambda: ui.launch(['cibyp-settings'])),
            ('info', '关于', lambda: ui.launch(['cibyp-about'])),
        ):
            foot.append(IconButton(icon, size=18, tooltip=tip, on_click=cb))
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        foot.append(spacer)
        app_btn = Gtk.Button(label='电源')
        app_btn.add_css_class('cibyp-btn')
        app_btn.connect('clicked', lambda *_: (self.hide(), app.toggle_power()))
        foot.append(app_btn)
        card.append(foot)

        self._fill()
        key = Gtk.EventControllerKey()
        key.connect('key-pressed', self._on_key)
        self.add_controller(key)
        self.connect('hide', lambda *_: app.menu_btn.set_selected(False) if hasattr(app, 'menu_btn') else None)

    def _on_bg_click(self, _g, _n, x, y):
        alloc = self.get_child().get_allocation()
        if x < alloc.width and y < alloc.height:
            self.hide()

    def _on_key(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.hide()
            return True
        return False

    def _fill(self):
        q = (self.search.get_text() or '').strip().lower()
        while (child := self.grid.get_first_child()) is not None:
            self.grid.remove(child)
        for app in self.apps:
            if q and q not in app['name'].lower() and q not in app['id'].lower():
                continue
            btn = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            btn.add_css_class('cibyp-subcard')
            btn.set_size_request(88, 84)
            btn.set_tooltip_text(app['name'])
            area = Gtk.DrawingArea()
            area.set_content_width(34)
            area.set_content_height(34)
            area.set_margin_top(10)
            icon = desktop_icon(app)
            area.set_draw_func(lambda _a, cr, w, h, ic=icon: ui.draw_icon(cr, ic, 0, 0, min(w, h)))
            area.set_halign(Gtk.Align.CENTER)
            btn.append(area)
            label = Gtk.Label(label=app['name'])
            label.set_ellipsize(Pango.EllipsizeMode.END)
            label.set_max_width_chars(9)
            label.add_css_class('cibyp-dim')
            btn.append(label)
            click = Gtk.GestureClick()
            click.connect('released', lambda _g, _n, _x, _y, a=app: (launch_desktop(a), self.hide()))
            btn.add_controller(click)
            self.grid.append(btn)

    def _open_first(self):
        child = self.grid.get_first_child()
        if child:
            for app in self.apps[:1]:
                launch_desktop(app)
            self.hide()

    def open(self):
        self._fill()
        self.search.set_text('')
        self.present()
        self.search.grab_focus()


# ------------------------------------------------------------------ 日历 / 电源 / 提示

class OverlayCard(Gtk.Window):
    """通用全屏透明层上的卡片（日历 / 电源 / 提示）"""

    def __init__(self, app, name, width, height, align_end=False, margin_bottom=12, margin_right=12):
        super().__init__(application=app)
        self.set_name(name)
        self.set_decorated(False)
        LayerShell.init_for_window(self)
        LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
        LayerShell.set_namespace(self, name)
        for e in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(self, e, True)
        LayerShell.set_exclusive_zone(self, -1)
        root = Gtk.Box()
        self.set_child(root)
        click = Gtk.GestureClick()
        click.connect('released', lambda *_: self.hide())
        root.add_controller(click)
        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.card.add_css_class('cibyp-card')
        self.card.set_size_request(width, height)
        self.card.set_halign(Gtk.Align.END if align_end else Gtk.Align.CENTER)
        self.card.set_valign(Gtk.Align.END)
        self.card.set_margin_bottom(margin_bottom)
        self.card.set_margin_end(margin_right)
        root.append(self.card)
        self.card.add_controller(Gtk.GestureClick())
        key = Gtk.EventControllerKey()
        key.connect('key-pressed', lambda _c, kv, _k, _s: (self.hide(), True)[1] if kv == Gdk.KEY_Escape else False)
        self.add_controller(key)


class CalendarCard(OverlayCard):
    def __init__(self, app):
        super().__init__(app, 'cibyp-calendar', 300, 300, align_end=True, margin_right=10)
        self.month_offset = 0
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        head.set_margin_top(12)
        head.set_margin_start(12)
        head.set_margin_end(12)
        prev = IconButton('back', size=14, on_click=lambda: self._shift(-1))
        nxt = IconButton('forward', size=14, on_click=lambda: self._shift(1))
        self.month_label = Gtk.Label()
        self.month_label.add_css_class('cibyp-title')
        self.month_label.set_hexpand(True)
        head.append(prev)
        head.append(self.month_label)
        head.append(nxt)
        self.card.append(head)
        self.week = Gtk.Label(label='一  二  三  四  五  六  日')
        self.week.add_css_class('cibyp-dim')
        self.card.append(self.week)
        self.days = Gtk.Grid()
        self.days.set_row_spacing(2)
        self.days.set_column_spacing(8)
        self.days.set_halign(Gtk.Align.CENTER)
        self.card.append(self.days)
        self._render()

    def _shift(self, d):
        self.month_offset += d
        self._render()

    def _render(self):
        now = datetime.now()
        y, m = now.year, now.month + self.month_offset
        while m < 1:
            m += 12
            y -= 1
        while m > 12:
            m -= 12
            y += 1
        self.month_label.set_label(f'{y} 年 {m} 月')
        while (c := self.days.get_first_child()) is not None:
            self.days.remove(c)
        import calendar
        first_weekday, days_in_month = calendar.monthrange(y, m)
        for i in range((first_weekday + 1) % 7):
            self.days.attach(Gtk.Label(label=''), i, 0, 1, 1)
        for day in range(1, days_in_month + 1):
            idx = (first_weekday + day - 1) % 7
            row = (first_weekday + day - 1) // 7
            lbl = Gtk.Label(label=str(day))
            lbl.set_size_request(28, 24)
            if y == now.year and m == now.month and day == now.day:
                lbl.add_css_class('cibyp-chip')
                lbl.add_css_class('cibyp-title')
            self.days.attach(lbl, idx, row, 1, 1)


class PowerCard(OverlayCard):
    def __init__(self, app):
        super().__init__(app, 'cibyp-power', 260, 120, align_end=True, margin_right=10)
        self.card.set_spacing(10)
        title = Gtk.Label(label='电源')
        title.add_css_class('cibyp-title')
        title.set_margin_top(14)
        self.card.append(title)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.set_halign(Gtk.Align.CENTER)
        row.set_margin_bottom(14)
        for icon, label, cb in (
            ('lock', '注销', lambda: ui.launch(['sudo', 'systemctl', 'restart', 'getty@tty1']) if False else self._logout()),
            ('reboot', '重启', lambda: ui.launch(['sudo', 'systemctl', 'reboot'])),
            ('power', '关机', lambda: ui.launch(['sudo', 'systemctl', 'poweroff'])),
        ):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            box.add_css_class('cibyp-subcard')
            box.set_size_request(70, 62)
            area = Gtk.DrawingArea()
            area.set_content_width(22)
            area.set_content_height(22)
            area.set_margin_top(8)
            area.set_halign(Gtk.Align.CENTER)
            area.set_draw_func(lambda _a, cr, w, h, ic=icon: ui.draw_icon(cr, ic, 0, 0, min(w, h),
                                                                         ui.DANGER if ic == 'power' else ui.TEXT))
            box.append(area)
            lbl = Gtk.Label(label=label)
            lbl.add_css_class('cibyp-dim')
            box.append(lbl)
            click = Gtk.GestureClick()
            click.connect('released', lambda _g, _n, _x, _y, f=cb: (f(), self.hide()))
            box.add_controller(click)
            row.append(box)
        self.card.append(row)

    def _logout(self):
        sway_cmd('exit')


class Toast(Gtk.Window):
    """右上角提示条（截图/设置反馈）"""

    def __init__(self, app):
        super().__init__(application=app)
        self.set_name('cibyp-toast')
        self.set_decorated(False)
        LayerShell.init_for_window(self)
        LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
        LayerShell.set_namespace(self, 'cibyp-toast')
        for e in (LayerShell.Edge.TOP, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(self, e, True)
        LayerShell.set_exclusive_zone(self, -1)
        # Gtk.Window 在 GTK4 没有 margin API：layer-shell 窗口用 LayerShell.set_margin
        LayerShell.set_margin(self, LayerShell.Edge.TOP, 48)
        LayerShell.set_margin(self, LayerShell.Edge.RIGHT, 12)
        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.box.add_css_class('cibyp-card')
        self.box.set_margin_start(6)
        self.box.set_margin_end(6)
        self.icon = Gtk.DrawingArea()
        self.icon.set_content_width(22)
        self.icon.set_content_height(22)
        self.box.append(self.icon)
        self.label = Gtk.Label(label='')
        self.label.add_css_class('cibyp-dim')
        self.label.set_margin_end(14)
        self.box.append(self.label)
        self.set_child(self.box)
        self._timeout = None
        self._icon = 'info'

    def notify(self, text, icon='info', ms=2200):
        self.label.set_label(text)
        self._icon = icon
        self.icon.set_draw_func(lambda _a, cr, w, h: ui.draw_icon(cr, self._icon, 0, 0, min(w, h), ui.ACCENT2))
        self.set_visible(True)
        if self._timeout:
            GLib.source_remove(self._timeout)
        self._timeout = GLib.timeout_add(ms, lambda: (self.set_visible(False), False)[1])


# ------------------------------------------------------------------ 应用

class ShellApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='com.b5software.cibyp.shell')
        self.panel = None
        self.menu = None
        self.calendar = None
        self.power = None
        self.toast = None

    def do_activate(self):
        ui.install_css()
        self.panel = Panel(self)
        self.menu = StartMenu(self)
        self.calendar = CalendarCard(self)
        self.power = PowerCard(self)
        self.toast = Toast(self)
        self.panel.present()
        self._serve_socket()

    # --- 外部命令 ---
    def _serve_socket(self):
        try:
            if os.path.exists(SOCKET_PATH):
                os.unlink(SOCKET_PATH)
            srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            srv.bind(SOCKET_PATH)
            srv.listen(4)
            GLib.io_add_watch(srv.fileno(), GLib.IO_IN, self._on_socket)
            self._srv = srv
        except Exception:
            pass

    def _on_socket(self, _fd, _cond):
        try:
            conn, _ = self._srv.accept()
            data = conn.recv(64).decode('utf-8', 'ignore').strip()
            conn.close()
            GLib.idle_add(lambda: (self.dispatch(data), False)[1])
        except Exception:
            pass
        return True

    def dispatch(self, cmd):
        if cmd == 'menu':
            self.toggle_menu()
        elif cmd == 'calendar':
            if self.calendar.get_visible():
                self.calendar.hide()
            else:
                self.calendar.present()
        elif cmd == 'power':
            self.toggle_power()
        elif cmd == 'screenshot':
            self.take_screenshot()
        elif cmd == 'toast':
            self.toast.notify('来自 cibypctl 的提示')

    def toggle_menu(self):
        if self.menu.get_visible():
            self.menu.hide()
        else:
            self.menu.open()
            self.panel.menu_btn.set_selected(True)

    def toggle_power(self):
        if self.power.get_visible():
            self.power.hide()
        else:
            self.power.present()

    def take_screenshot(self):
        pics = os.path.expanduser('~/Pictures')
        os.makedirs(pics, exist_ok=True)
        name = datetime.now().strftime('screenshot-%Y%m%d-%H%M%S.png')
        target = os.path.join(pics, name)
        try:
            r = subprocess.run(['grim', target], capture_output=True, timeout=15)
            if r.returncode == 0 and os.path.exists(target):
                self.toast.notify(f'截图已保存：图片/{name}', icon='wallpaper')
            else:
                self.toast.notify('截图失败：' + (r.stderr.decode('utf-8', 'ignore')[:60] or 'grim 不可用'), icon='info')
        except Exception as e:
            self.toast.notify('截图失败：' + str(e)[:60], icon='info')


def main():
    ui.ensure_layer_shell_preload()  # layer-shell 需 LD_PRELOAD：自动带环境重执行一次
    if not single_instance_guard('cibyp-shell'):
        print('cibyp-shell: 已有一个实例在运行，退出', file=sys.stderr)
        return 0
    app = ShellApp()
    return app.run([])


if __name__ == '__main__':
    sys.exit(main())
