# cibyp-files —— CIBYP 桌面「文件」应用（自研，GTK4 + Cairo，无第三方图标/主题资源）
#
# 功能：
#   - 左侧 places 侧栏（主目录/文档/下载/工作区/根目录）
#   - 路径栏 + 后退/前进/上级/主目录按钮，回车跳转
#   - 右侧列表（名称/大小/修改时间，Gtk.ColumnView）
#   - 新建文件夹、重命名、删除（确认对话框）、复制/剪切/粘贴（内部实现）
#   - xdg-open 用默认程序打开；双击进入目录
#   - 状态栏显示条目数与当前路径，错误以中文提示条/对话框呈现
#
# 依赖：python3-gi + GTK4（其余仅标准库）。

import os
import shutil
import sys
import time

# ---- 共享绘制库路径（镜像内 /usr/local 与开发树 ../lib 均可） ----
for _p in ('/usr/local/lib/cibyp-desktop/lib',
           os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib')):
    if _p not in sys.path:
        sys.path.insert(0, _p)

import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')

from gi.repository import Gdk, Gio, GLib, GObject, Gtk  # noqa: E402

import cibypui  # noqa: E402

APP_ID = 'com.b5software.cibyp.files'
WINDOW_NAME = 'cibyp-files'

LOCAL_CSS = b"""
window.cibyp-app { background: rgb(11, 15, 26); }
.cibyp-toolbar { background: rgba(15, 20, 33, 0.90); border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
.cibyp-statusbar { background: rgba(15, 20, 33, 0.90); border-top: 1px solid rgba(255, 255, 255, 0.06); }
.cibyp-sidebar { background: rgba(15, 20, 33, 0.55); border-right: 1px solid rgba(255, 255, 255, 0.06); }
.cibyp-danger { color: rgb(255, 107, 129); }
"""

IMAGE_EXT = {'.png', '.jpg', '.jpeg', '.gif', '.webp', '.bmp', '.svg'}
TEXT_EXT = {'.txt', '.md', '.log', '.py', '.sh', '.json', '.ini', '.cfg', '.conf',
            '.toml', '.yaml', '.yml', '.csv', '.c', '.h', '.cpp', '.css', '.html', '.xml'}


# ------------------------------------------------------------------ 纯逻辑函数
# 以下函数不依赖 GUI，可用 python3 -c 单独验证。

def human_size(n):
    """把字节数格式化为可读字符串"""
    if n is None:
        return '—'
    if n < 1024:
        return f'{n} B'
    value = float(n)
    for unit in ('KiB', 'MiB', 'GiB', 'TiB'):
        value /= 1024.0
        if value < 1024.0:
            return f'{value:.1f} {unit}'
    return f'{value:.1f} PiB'


def icon_for(name, is_dir):
    """按类型挑选自绘图标名（取值见 cibypui.draw_icon 分支）"""
    if is_dir:
        return 'folder'
    ext = os.path.splitext(name)[1].lower()
    if ext in IMAGE_EXT:
        return 'image'
    if ext in TEXT_EXT:
        return 'editor'
    return 'file'


def scan_dir(path, reverse=False):
    """读取目录 → [(name, path, is_dir, size, mtime)]，目录优先、名称不区分大小写排序"""
    rows = []
    with os.scandir(path) as it:
        for entry in it:
            try:
                st = entry.stat(follow_symlinks=False)
                is_dir = entry.is_dir(follow_symlinks=False)
                size = None if is_dir else st.st_size
                rows.append((entry.name, entry.path, is_dir, size, st.st_mtime))
            except OSError:
                continue  # 单个条目读取失败不影响整目录
    rows.sort(key=lambda r: (not r[2], r[0].casefold()), reverse=reverse)
    return rows


def unique_target(dst_dir, name):
    """在目标目录内为 name 找一个不冲突的新名字（加「副本」后缀）"""
    base, ext = os.path.splitext(name)
    candidate = os.path.join(dst_dir, name)
    index = 0
    while os.path.exists(candidate) or os.path.islink(candidate):
        index += 1
        suffix = ' (副本)' if index == 1 else f' (副本{index})'
        candidate = os.path.join(dst_dir, f'{base}{suffix}{ext}')
        if index > 9999:
            break
    return candidate


def copy_path(src, dst_dir):
    """复制文件/目录到目标目录，返回实际落盘路径"""
    dst = unique_target(dst_dir, os.path.basename(src))
    if os.path.isdir(src) and not os.path.islink(src):
        shutil.copytree(src, dst, symlinks=True)
    else:
        shutil.copy2(src, dst, follow_symlinks=False)
    return dst


def paste_items(paths, mode, dst_dir):
    """粘贴（复制/剪切）多个条目 → [(ok, 落盘路径或错误文本)]"""
    results = []
    for src in paths:
        try:
            if not os.path.exists(src) and not os.path.islink(src):
                results.append((False, f'源已不存在：{src}'))
                continue
            if (mode != 'cut' and os.path.isdir(src) and not os.path.islink(src)
                    and (os.path.abspath(dst_dir) == os.path.abspath(src)
                         or os.path.abspath(dst_dir).startswith(os.path.abspath(src) + os.sep))):
                results.append((False, f'不能把目录复制到它自己里面：{src}'))
                continue
            if mode == 'cut':
                dst = unique_target(dst_dir, os.path.basename(src))
                shutil.move(src, dst)
            else:
                dst = copy_path(src, dst_dir)
            results.append((True, dst))
        except Exception as exc:  # noqa: BLE001 —— 保证任何失败都不崩溃
            results.append((False, f'{os.path.basename(src)}：{exc}'))
    return results


def default_places():
    """侧栏 places 列表 → [(标题, 路径, 图标名)]"""
    home = os.path.expanduser('~')
    docs = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) \
        or os.path.join(home, 'Documents')
    down = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) \
        or os.path.join(home, 'Downloads')
    items = [
        ('主目录', home, 'home'),
        ('文档', docs, 'file'),
        ('下载', down, 'file'),
        ('工作区', '/workspace', 'grid'),
        ('根目录', '/', 'up'),
    ]
    return [it for it in items if it[0] == '根目录' or os.path.isdir(it[1])]


# ------------------------------------------------------------------ 小工具

def install_local_css():
    """补充窗口背景/工具条样式（配色仍取自 cibypui 设计令牌）"""
    provider = Gtk.CssProvider()
    provider.load_from_data(LOCAL_CSS)
    display = Gdk.Display.get_default()
    if display is not None:
        Gtk.StyleContext.add_provider_for_display(
            display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def make_icon(name, size=18, color=None, stroke=1.9):
    """自绘图标控件（Gtk.DrawingArea + cibypui.draw_icon）"""
    col = color or cibypui.TEXT

    def _draw(_area, cr, w, h, _data):
        cibypui.draw_icon(cr, name, 0, 0, min(w, h), col, stroke)

    area = Gtk.DrawingArea()
    area.set_content_width(size)
    area.set_content_height(size)
    area.set_draw_func(_draw, None)
    return area


def tool_button(name, tip, callback, size=18, color=None):
    btn = Gtk.Button()
    btn.add_css_class('cibyp-btn')
    btn.set_child(make_icon(name, size, color))
    btn.set_tooltip_text(tip)
    btn.connect('clicked', lambda *_a: callback())
    return btn


def label(text, css=None, xalign=0.0):
    lbl = Gtk.Label(label=text, xalign=xalign)
    if css:
        lbl.add_css_class(css)
    return lbl


def pad(widget, margin):
    widget.set_margin_top(margin)
    widget.set_margin_bottom(margin)
    widget.set_margin_start(margin)
    widget.set_margin_end(margin)
    return widget


def show_error(parent, message, detail=''):
    """错误对话框（中文）"""
    dlg = Gtk.AlertDialog()
    dlg.set_modal(True)
    dlg.set_message(message)
    if detail:
        dlg.set_detail(detail)
    dlg.set_buttons(['知道了'])
    try:
        dlg.show(parent)
    except Exception:
        pass


def text_prompt(parent, title, initial, on_ok, ok_label='确定'):
    """带输入框的模态小窗（新建文件夹 / 重命名）"""
    win = Gtk.Window(transient_for=parent, modal=True, title=title)
    win.add_css_class('cibyp-app')
    win.set_resizable(False)
    win.set_default_size(380, -1)

    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    card.add_css_class('cibyp-card')
    pad(card, 12)

    card.append(label(title, 'cibyp-title'))
    entry = Gtk.Entry()
    entry.add_css_class('cibyp-entry')
    entry.set_text(initial or '')
    entry.set_position(-1)
    card.append(entry)

    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    row.set_halign(Gtk.Align.END)
    cancel = Gtk.Button(label='取消')
    cancel.add_css_class('cibyp-btn')
    ok = Gtk.Button(label=ok_label)
    ok.add_css_class('cibyp-btn')
    ok.add_css_class('accent')
    row.append(cancel)
    row.append(ok)
    card.append(row)
    win.set_child(card)

    def _apply(*_a):
        value = entry.get_text().strip()
        win.destroy()
        if value:
            try:
                on_ok(value)
            except Exception as exc:  # noqa: BLE001
                show_error(parent, '操作失败', str(exc))

    cancel.connect('clicked', lambda *_a: win.destroy())
    ok.connect('clicked', _apply)
    entry.connect('activate', _apply)

    key = Gtk.EventControllerKey()
    key.connect('key-pressed', lambda _c, keyval, _kc, _st:
                (win.destroy(), True)[1] if keyval == Gdk.KEY_Escape else False)
    win.add_controller(key)

    win.present()
    entry.grab_focus()


def confirm(parent, message, detail, on_ok, ok_label='删除'):
    """确认对话框（危险操作）"""
    dlg = Gtk.AlertDialog()
    dlg.set_modal(True)
    dlg.set_message(message)
    if detail:
        dlg.set_detail(detail)
    dlg.set_buttons(['取消', ok_label])
    dlg.set_cancel_button(0)
    dlg.set_default_button(0)

    def _done(source, result, _data):
        try:
            index = source.choose_finish(result)
        except Exception:
            return
        if index == 1:
            try:
                on_ok()
            except Exception as exc:  # noqa: BLE001
                show_error(parent, '操作失败', str(exc))

    try:
        dlg.choose(parent, None, _done, None)
    except Exception as exc:  # noqa: BLE001
        show_error(parent, '无法显示确认对话框', str(exc))


# ------------------------------------------------------------------ 数据模型

class FileItem(GObject.Object):
    """列表行数据"""

    __gtype_name__ = 'CibypFileItem'

    name = GObject.Property(type=str, default='')
    path = GObject.Property(type=str, default='')
    size_text = GObject.Property(type=str, default='')
    mtime_text = GObject.Property(type=str, default='')
    icon = GObject.Property(type=str, default='file')
    is_dir = GObject.Property(type=bool, default=False)
    size = GObject.Property(type=float, default=0.0)
    mtime = GObject.Property(type=float, default=0.0)


def build_item(row):
    """(name, path, is_dir, size, mtime) → FileItem"""
    name, path, is_dir, size, mtime = row
    try:
        mtime_text = time.strftime('%Y-%m-%d %H:%M', time.localtime(mtime))
    except (OSError, ValueError, OverflowError):
        mtime_text = '—'
    item = FileItem()
    item.name = name
    item.path = path
    item.is_dir = is_dir
    item.size = float(size or 0)
    item.mtime = float(mtime or 0)
    item.size_text = '—' if is_dir else human_size(size)
    item.mtime_text = mtime_text
    item.icon = icon_for(name, is_dir)
    return item


# ------------------------------------------------------------------ 列表控件工厂

def _setup_name_cell(_factory, cell):
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    box.set_margin_top(2)
    box.set_margin_bottom(2)
    box.set_margin_start(4)
    area = Gtk.DrawingArea()
    area.set_content_width(18)
    area.set_content_height(18)
    area.set_valign(Gtk.Align.CENTER)
    text = Gtk.Label(xalign=0.0)
    text.set_ellipsize(3)
    text.set_hexpand(True)
    box.append(area)
    box.append(text)
    cell.set_child(box)


def _bind_name_cell(_factory, cell):
    item = cell.get_item()
    box = cell.get_child()
    area = box.get_first_child()
    text = area.get_next_sibling()
    if item is None:
        text.set_text('')
        return
    name = item.name
    is_dir = bool(item.is_dir)
    icon = 'folder' if is_dir else item.icon
    color = cibypui.ACCENT2 if is_dir else cibypui.TEXT

    def _draw(_a, cr, w, h, _d):
        cibypui.draw_icon(cr, icon, 0, 0, min(w, h), color)

    area.set_draw_func(_draw, None)
    area.queue_draw()
    text.set_text(name)


def _setup_text_cell(_factory, cell):
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    box.set_margin_top(2)
    box.set_margin_bottom(2)
    box.set_margin_start(4)
    lbl = Gtk.Label(xalign=0.0)
    lbl.add_css_class('cibyp-dim')
    box.append(lbl)
    cell.set_child(box)


def _bind_text_cell(_factory, cell, prop):
    item = cell.get_item()
    box = cell.get_child()
    child = box.get_last_child()
    child.set_text(item.get_property(prop) if item is not None else '')


def _item_from_widget(widget):
    """从列表行控件向上找到带 get_item() 的单元格/行对象"""
    node = widget
    for _ in range(4):
        if node is None:
            return None
        getter = getattr(node, 'get_item', None)
        if callable(getter):
            try:
                return getter()
            except Exception:  # noqa: BLE001
                return None
        node = node.get_parent()
    return None


# ------------------------------------------------------------------ 主窗口

class FilesWindow(Gtk.ApplicationWindow):

    def __init__(self, app):
        super().__init__(application=app, title='文件')
        self.set_name(WINDOW_NAME)
        self.add_css_class('cibyp-app')
        self.set_default_size(900, 600)

        self.cwd = os.path.expanduser('~')
        if not os.path.isdir(self.cwd):
            self.cwd = '/'
        self.history = [self.cwd]
        self.history_index = 0
        self.clipboard = {'mode': None, 'paths': []}
        self.place_rows = []
        self._toast_token = 0

        self._build_header()
        self._build_body()
        self._update_clip_label()
        self.navigate(self.cwd, record=False)

    # --------------------------------------------------------- 界面搭建

    def _build_header(self):
        header = Gtk.HeaderBar()
        header.add_css_class('cibyp-panel')
        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title_box.append(make_icon('files', 16))
        title_box.append(label('文件', 'cibyp-title'))
        header.set_title_widget(title_box)
        self.set_titlebar(header)

    def _build_body(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(root)

        root.append(self._build_pathbar())
        root.append(self._build_actionbar())

        content = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        content.set_vexpand(True)
        content.append(self._build_sidebar())
        content.append(self._build_list())
        root.append(content)
        root.append(self._build_statusbar())

    def _build_pathbar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        bar.add_css_class('cibyp-toolbar')
        for name, tip, cb in (
            ('back', '后退', self.go_back),
            ('forward', '前进', self.go_forward),
            ('up', '上级目录', self.go_up),
            ('home', '主目录', self.go_home),
        ):
            bar.append(tool_button(name, tip, cb))

        self.path_entry = Gtk.Entry()
        self.path_entry.add_css_class('cibyp-entry')
        self.path_entry.add_css_class('cibyp-mono')
        self.path_entry.set_hexpand(True)
        self.path_entry.set_placeholder_text('输入路径后回车跳转')
        self.path_entry.connect('activate', self._on_path_enter)
        bar.append(self.path_entry)
        bar.append(tool_button('refresh', '刷新', lambda: self.navigate(self.cwd, record=False)))
        return pad(bar, 6)

    def _build_actionbar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        bar.add_css_class('cibyp-toolbar')
        for name, tip, cb in (
            ('plus', '新建文件夹', self.new_folder),
            ('open', '用默认程序打开', self.open_selected),
            ('edit', '重命名', self.rename_selected),
            ('copy', '复制', lambda: self.set_clipboard('copy')),
            ('cut', '剪切', lambda: self.set_clipboard('cut')),
            ('paste', '粘贴', self.paste_here),
            ('trash', '删除', self.delete_selected),
        ):
            bar.append(tool_button(name, tip, cb))
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        bar.append(spacer)
        self.selection_hint = label('', 'cibyp-dim')
        bar.append(self.selection_hint)
        return pad(bar, 6)

    def _build_sidebar(self):
        self.places_box = Gtk.ListBox()
        self.places_box.add_css_class('cibyp-list')
        self.places_box.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.places_box.connect('row-activated', self._on_place)

        for title, path, icon in default_places():
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            pad(box, 6)
            box.append(make_icon(icon, 16))
            box.append(label(title))
            row.set_child(box)
            row.place_path = path
            self.places_box.append(row)
            self.place_rows.append(row)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_child(self.places_box)
        scroll.add_css_class('cibyp-sidebar')
        scroll.set_size_request(190, -1)
        return scroll

    def _build_list(self):
        self.store = Gio.ListStore.new(FileItem)
        self.selection = Gtk.SingleSelection.new(self.store)
        self.selection.set_autoselect(False)
        self.selection.connect('notify::selected', lambda *_a: self._update_selection_hint())

        self.view = Gtk.ColumnView.new(self.selection)
        self.view.add_css_class('cibyp-list')
        self.view.set_show_row_separators(False)
        self.view.set_show_column_separators(False)
        self.view.set_vexpand(True)
        self.view.set_hexpand(True)

        self.view.append_column(self._column_name())
        self.view.append_column(self._column_size())
        self.view.append_column(self._column_mtime())

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.set_child(self.view)
        return scroll

    def _column_name(self):
        factory = Gtk.SignalListItemFactory()
        factory.connect('setup', _setup_name_cell)
        factory.connect('setup', self._setup_row_gesture)   # 双击手势（依赖 cell 子控件已建好）
        factory.connect('bind', _bind_name_cell)

        col = Gtk.ColumnViewColumn.new('名称', factory)
        col.set_expand(True)
        col.set_resizable(True)
        return col

    def _column_size(self):
        factory = Gtk.SignalListItemFactory()
        factory.connect('setup', _setup_text_cell)
        factory.connect('setup', self._setup_row_gesture)
        factory.connect('bind', lambda f, c: _bind_text_cell(f, c, 'size_text'))
        col = Gtk.ColumnViewColumn.new('大小', factory)
        col.set_fixed_width(110)
        col.set_resizable(True)
        return col

    def _column_mtime(self):
        factory = Gtk.SignalListItemFactory()
        factory.connect('setup', _setup_text_cell)
        factory.connect('setup', self._setup_row_gesture)
        factory.connect('bind', lambda f, c: _bind_text_cell(f, c, 'mtime_text'))
        col = Gtk.ColumnViewColumn.new('修改时间', factory)
        col.set_fixed_width(170)
        col.set_resizable(True)
        return col

    def _setup_row_gesture(self, _factory, cell):
        """给每个列表行挂双击手势：目录进入、文件用默认程序打开"""
        box = cell.get_child()
        if box is None:
            return
        gesture = Gtk.GestureClick()
        gesture.set_button(1)
        gesture.connect('pressed', self._on_row_pressed)
        box.add_controller(gesture)

    def _on_row_pressed(self, gesture, n_press, _x, _y):
        if n_press != 2:
            return
        widget = gesture.get_widget()
        item = _item_from_widget(widget)
        if item is None:
            return
        if item.is_dir:
            self.navigate(item.path)
        else:
            self._open_item(item)

    def _build_statusbar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bar.add_css_class('cibyp-statusbar')
        self.status_label = label('', 'cibyp-dim', 0.0)
        self.status_label.set_hexpand(True)
        self.status_label.set_ellipsize(3)
        self.clip_label = label('剪贴板：空', 'cibyp-dim', 1.0)
        bar.append(self.status_label)
        bar.append(self.clip_label)
        return pad(bar, 5)

    # --------------------------------------------------------- 导航

    def navigate(self, path, record=True):
        path = os.path.abspath(os.path.expanduser(path))
        if not os.path.isdir(path):
            self.toast(f'无法进入：{path}', error=True)
            return False
        try:
            rows = scan_dir(path)
        except OSError as exc:
            self.toast(f'无法读取目录：{exc}', error=True)
            return False

        self.cwd = path
        self.store.remove_all()
        for row in rows:
            self.store.append(build_item(row))
        self.path_entry.set_text(path)
        self.set_title(f'文件 — {path}')
        if record:
            self.history = self.history[:self.history_index + 1]
            self.history.append(path)
            self.history_index = len(self.history) - 1
        self._reload_places_selection()
        self._refresh_status()
        self._update_selection_hint()
        return True

    def go_back(self):
        if self.history_index > 0:
            self.history_index -= 1
            self.navigate(self.history[self.history_index], record=False)
        else:
            self.toast('已经是最早的位置')

    def go_forward(self):
        if self.history_index < len(self.history) - 1:
            self.history_index += 1
            self.navigate(self.history[self.history_index], record=False)
        else:
            self.toast('没有更新的位置')

    def go_up(self):
        parent = os.path.dirname(os.path.normpath(self.cwd))
        if parent and parent != self.cwd:
            self.navigate(parent)
        else:
            self.toast('已经是顶层目录')

    def go_home(self):
        self.navigate(os.path.expanduser('~'))

    def _on_path_enter(self, entry):
        text = entry.get_text().strip()
        if text and not self.navigate(text):
            entry.set_text(self.cwd)

    def _on_place(self, _box, row):
        path = getattr(row, 'place_path', None)
        if path:
            self.navigate(path)

    def _reload_places_selection(self):
        target = os.path.abspath(self.cwd)
        for row in self.place_rows:
            if os.path.abspath(row.place_path) == target:
                self.places_box.select_row(row)
                return
        self.places_box.unselect_all()

    # --------------------------------------------------------- 文件操作

    def selected_item(self):
        item = self.selection.get_selected_item()
        return item if item is not None else None

    def selected_paths(self):
        item = self.selected_item()
        if item is None:
            self.toast('请先选择一个条目', error=True)
            return []
        return [item.path]

    def new_folder(self):
        def _create(name):
            if os.sep in name or name in ('.', '..'):
                raise ValueError('名称不合法')
            target = os.path.join(self.cwd, name)
            if os.path.exists(target):
                raise FileExistsError('同名条目已存在')
            os.mkdir(target)
            self.navigate(self.cwd, record=False)
            self.toast(f'已新建文件夹「{name}」')

        text_prompt(self, '新建文件夹', '新建文件夹', _create, ok_label='创建')

    def rename_selected(self):
        item = self.selected_item()
        if item is None:
            self.toast('请先选择要重命名的条目', error=True)
            return

        def _rename(name):
            if os.sep in name or name in ('.', '..'):
                raise ValueError('名称不合法')
            target = os.path.join(self.cwd, name)
            if target != item.path and os.path.exists(target):
                raise FileExistsError('同名条目已存在')
            os.rename(item.path, target)
            self.navigate(self.cwd, record=False)
            self.toast(f'已重命名为「{name}」')

        text_prompt(self, '重命名', item.name, _rename, ok_label='重命名')

    def delete_selected(self):
        item = self.selected_item()
        if item is None:
            self.toast('请先选择要删除的条目', error=True)
            return
        kind = '文件夹' if item.is_dir else '文件'

        def _do_delete():
            if item.is_dir and not os.path.islink(item.path):
                shutil.rmtree(item.path)
            else:
                os.remove(item.path)
            self.navigate(self.cwd, record=False)
            self.toast(f'已删除{kind}「{item.name}」')

        confirm(self, '确认删除？',
                f'将永久删除{kind}：{item.name}\n此操作不可撤销。', _do_delete)

    def set_clipboard(self, mode):
        paths = self.selected_paths()
        if not paths:
            return
        self.clipboard = {'mode': mode, 'paths': paths}
        word = '复制' if mode == 'copy' else '剪切'
        self.toast(f'已{word} {len(paths)} 项，可在其他目录粘贴')
        self._update_clip_label()

    def paste_here(self):
        mode = self.clipboard.get('mode')
        paths = self.clipboard.get('paths') or []
        if not mode or not paths:
            self.toast('剪贴板为空', error=True)
            return
        results = paste_items(paths, mode, self.cwd)
        ok = [r for r in results if r[0]]
        bad = [r[1] for r in results if not r[0]]
        if mode == 'cut':
            self.clipboard = {'mode': None, 'paths': []}
            self._update_clip_label()
        self.navigate(self.cwd, record=False)
        if bad:
            show_error(self, f'{len(bad)} 项粘贴失败', '\n'.join(bad[:6]))
        if ok:
            self.toast(f'已粘贴 {len(ok)} 项')

    def open_selected(self):
        item = self.selected_item()
        if item is None:
            self.toast('请先选择要打开的条目', error=True)
            return
        if item.is_dir:
            self.navigate(item.path)
        else:
            self._open_item(item)

    def _open_item(self, item):
        if cibypui.which('xdg-open'):
            cibypui.launch(['xdg-open', item.path])
            self.toast(f'已用默认程序打开「{item.name}」')
            return
        try:
            Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(item.path, None), None)
            self.toast(f'已用默认程序打开「{item.name}」')
        except Exception as exc:  # noqa: BLE001
            show_error(self, '打开失败', f'{item.name}：{exc}')

    # --------------------------------------------------------- 状态与提示

    def _refresh_status(self):
        self.status_label.set_text(f'{self.store.get_n_items()} 个条目 · {self.cwd}')
        self.status_label.remove_css_class('cibyp-danger')

    def _update_selection_hint(self):
        item = self.selected_item()
        if item is None:
            self.selection_hint.set_text('')
        else:
            self.selection_hint.set_text(f"{'文件夹' if item.is_dir else '文件'} · {item.name}")

    def _update_clip_label(self):
        mode = self.clipboard.get('mode')
        n = len(self.clipboard.get('paths') or [])
        if not mode or not n:
            self.clip_label.set_text('剪贴板：空')
        else:
            self.clip_label.set_text(f"剪贴板：{'复制' if mode == 'copy' else '剪切'} {n} 项")

    def toast(self, text, error=False):
        """底部提示条（5 秒后恢复条目数/路径）"""
        self._toast_token += 1
        token = self._toast_token
        self.status_label.set_text(text)
        if error:
            self.status_label.add_css_class('cibyp-danger')
        else:
            self.status_label.remove_css_class('cibyp-danger')

        def _restore():
            if token == self._toast_token:
                self._refresh_status()
            return False

        GLib.timeout_add(5000, _restore)


# ------------------------------------------------------------------ 应用

class FilesApp(Gtk.Application):

    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        try:
            cibypui.install_css()
            install_local_css()
            win = FilesWindow(self)
            initial = cibypui.arg_path()
            if initial:
                win.navigate(initial)
            win.present()
        except Exception as exc:  # noqa: BLE001 —— 启动异常不静默崩溃
            print(f'cibyp-files: 启动失败: {exc}', file=sys.stderr)


def main():
    return FilesApp().run([sys.argv[0]])


if __name__ == '__main__':
    sys.exit(main())
