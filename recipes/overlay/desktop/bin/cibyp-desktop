import sys
from pathlib import Path
local = Path(__file__).resolve().parent.parent / 'lib'
sys.path.insert(0, str(local if local.is_dir() else Path('/usr/local/lib/cibyp-desktop/lib')))
import cibypui as ui
ui.ensure_layer_shell_preload()
if not ui.acquire_single_instance('desktop'):
    sys.exit(0)
from campus_desktop import DesktopWindow
sys.exit(ui.run_application('desktop', DesktopWindow))
