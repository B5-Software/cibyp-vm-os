#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (c) 2026 B5-Software
#
# cibyp-input —— 自研 Wayland 鼠标注入器（Linux uinput，零第三方依赖）
#
# 为什么自研：ydotool 在 Debian 13 只存在于 backports（镜像仅启用 main），
# 而鼠标注入是 VM 内 computer-use 的刚需。这里直接写 /dev/uinput，
# 用「相对位移」合成绝对目标位置（位置状态存于 $XDG_RUNTIME_DIR/cibyp-input.pos）。
#
# 用法（与 ydotool 子集对齐，便于应用侧无缝回退）：
#   cibyp-input move <x> <y>          移动到绝对坐标
#   cibyp-input click [left|right|middle] [--repeat N]
#   cibyp-input mousedown|mouseup [left|right|middle]
#   cibyp-input scroll <up|down> [N]
#   cibyp-input pos                   打印当前跟踪位置（x y）
#
# 权限：需要写 /dev/uinput（cibyp 用户有 NOPASSWD sudo，镜像内可直接跑；
# 无权限时给出明确提示并以非零退出）。

import fcntl
import os
import struct
import sys
import time

UI_SET_EVBIT = 0x40045564
UI_SET_KEYBIT = 0x40045565
UI_SET_RELBIT = 0x40045566
UI_DEV_CREATE = 0x5501
UI_DEV_DESTROY = 0x5502

EV_SYN, EV_KEY, EV_REL = 0, 1, 2
REL_X, REL_Y, REL_HWHEEL, REL_WHEEL = 0, 1, 6, 8
BTN = {'left': 0x110, 'right': 0x111, 'middle': 0x112}

UINPUT = '/dev/uinput'
POS_FILE = os.path.join(os.environ.get('XDG_RUNTIME_DIR', '/tmp'), 'cibyp-input.pos')
EVENT_FMT = 'llHHi'          # struct input_event（64 位 timeval + type + code + value）
EVENT_SIZE = struct.calcsize(EVENT_FMT)


def die(msg, code=1):
    print('cibyp-input:', msg, file=sys.stderr)
    sys.exit(code)


def emit(fd, etype, code, value):
    fd.write(struct.pack(EVENT_FMT, 0, 0, etype, code, value))


def syn(fd):
    emit(fd, EV_SYN, 0, 0)


def open_device():
    if not os.path.exists(UINPUT):
        die('/dev/uinput 不存在（内核未提供 uinput 模块）')
    try:
        fd = os.open(UINPUT, os.O_WRONLY | os.O_NONBLOCK)
    except PermissionError:
        die('无权访问 /dev/uinput（请用 sudo 运行，或把用户加入 input 组）')
    import io
    f = io.FileIO(fd, 'wb', closefd=True)

    for ev in (EV_KEY, EV_REL):
        fcntl.ioctl(fd, UI_SET_EVBIT, ev)
    for btn in BTN.values():
        fcntl.ioctl(fd, UI_SET_KEYBIT, btn)
    for rel in (REL_X, REL_Y, REL_WHEEL, REL_HWHEEL):
        fcntl.ioctl(fd, UI_SET_RELBIT, rel)

    # uinput_user_dev：name[80] + input_id(4*u16) + absmax/absmin/absfuzz/absflat(4*4*i32)
    name = b'CIBYP Virtual Mouse\0'
    name = name + b'\0' * (80 - len(name))
    dev = struct.pack('80sHHHHi', name, 0x03, 0x01, 1, 0, 0)  # BUS_USB / vendor / product / version
    dev += b'\0' * 16 * 4  # ABS 参数区（不需要）
    f.write(dev)
    f.flush()
    fcntl.ioctl(fd, UI_DEV_CREATE)
    time.sleep(0.25)  # 等内核/合成器识别设备
    return fd, f


def read_pos():
    try:
        with open(POS_FILE, 'r', encoding='utf-8') as fh:
            x, y = fh.read().split()
            return int(x), int(y)
    except Exception:
        return 0, 0


def write_pos(x, y):
    try:
        with open(POS_FILE, 'w', encoding='utf-8') as fh:
            fh.write(f'{x} {y}')
    except Exception:
        pass


def move_to(fd, x, y):
    cx, cy = read_pos()
    dx, dy = x - cx, y - cy
    # 分步发送，单步不超过 120px，避免合成器一次吃掉过大位移
    steps = max(1, int(max(abs(dx), abs(dy)) / 120) + 1)
    for i in range(steps):
        emit(fd, EV_REL, REL_X, int(round(dx / steps)))
        emit(fd, EV_REL, REL_Y, int(round(dy / steps)))
        syn(fd)
        time.sleep(0.01)
    write_pos(x, y)


def click(fd, button='left', repeat=1, hold=False, release=False):
    code = BTN.get(button, BTN['left'])
    if release:
        emit(fd, EV_KEY, code, 0)
        syn(fd)
        return
    if hold:
        emit(fd, EV_KEY, code, 1)
        syn(fd)
        return
    for _ in range(max(1, repeat)):
        emit(fd, EV_KEY, code, 1)
        syn(fd)
        emit(fd, EV_KEY, code, 0)
        syn(fd)
        time.sleep(0.06)


def scroll(fd, direction, n=1):
    code = REL_WHEEL
    value = 1 if direction == 'up' else -1
    for _ in range(max(1, n)):
        emit(fd, EV_REL, code, value)
        syn(fd)
        time.sleep(0.04)


def main(argv):
    if not argv:
        die('用法: cibyp-input move <x> <y> | click [left|right|middle] [--repeat N] | mousedown|mouseup [btn] | scroll up|down [N] | pos')
    cmd = argv[0]
    if cmd == 'pos':
        x, y = read_pos()
        print(f'{x} {y}')
        return 0
    fd, f = open_device()
    try:
        if cmd == 'move' and len(argv) >= 3:
            move_to(fd, int(float(argv[1])), int(float(argv[2])))
        elif cmd == 'click':
            btn = argv[1] if len(argv) > 1 and not argv[1].startswith('--') else 'left'
            repeat = 1
            if '--repeat' in argv:
                repeat = int(argv[argv.index('--repeat') + 1])
            click(fd, btn, repeat)
        elif cmd in ('mousedown', 'mouseup'):
            btn = argv[1] if len(argv) > 1 else 'left'
            click(fd, btn, hold=(cmd == 'mousedown'), release=(cmd == 'mouseup'))
        elif cmd == 'scroll':
            direction = argv[1] if len(argv) > 1 else 'down'
            n = int(argv[2]) if len(argv) > 2 else 1
            scroll(fd, direction, n)
        else:
            die('未知命令: ' + ' '.join(argv))
    finally:
        try:
            fcntl.ioctl(fd, UI_DEV_DESTROY)
        except Exception:
            pass
        try:
            f.close()
        except Exception:
            pass
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
